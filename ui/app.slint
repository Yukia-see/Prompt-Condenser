import { Button, ComboBox, CheckBox, LineEdit, TextEdit, Slider, ScrollView } from "std-widgets.slint";

// Google Material 3 + OLED Multi-Theme Color Tokens
// theme-index:
//   0 = OLED Pitch Black (#000000)
//   1 = M3 Deep Violet (Default)
//   2 = OLED Cyber Emerald
//   3 = M3 Ocean Blue
//   4 = M3 Crimson Ember
//   5 = M3 Mocha Gold
export global M3 {
    in-out property <int> theme-index: 0;

    out property <color> surface:
        root.theme-index == 0 ? #000000 :
        root.theme-index == 2 ? #000000 :
        root.theme-index == 3 ? #070D17 :
        root.theme-index == 4 ? #0C0608 :
        root.theme-index == 5 ? #0B0905 : #141218;

    out property <color> surface-container-low:
        root.theme-index == 0 ? #09090B :
        root.theme-index == 2 ? #08110E :
        root.theme-index == 3 ? #0E1726 :
        root.theme-index == 4 ? #170C10 :
        root.theme-index == 5 ? #16120B : #1D1B20;

    out property <color> surface-container:
        root.theme-index == 0 ? #121216 :
        root.theme-index == 2 ? #101F1A :
        root.theme-index == 3 ? #162236 :
        root.theme-index == 4 ? #241319 :
        root.theme-index == 5 ? #221C12 : #211F26;

    out property <color> surface-container-high:
        root.theme-index == 0 ? #1C1C22 :
        root.theme-index == 2 ? #182D26 :
        root.theme-index == 3 ? #1F304A :
        root.theme-index == 4 ? #331C24 :
        root.theme-index == 5 ? #302819 : #2B2930;

    out property <color> on-surface:
        root.theme-index == 0 ? #F4F4F6 :
        root.theme-index == 2 ? #E4F5EE :
        root.theme-index == 3 ? #E3EDF8 :
        root.theme-index == 4 ? #F9E6EC :
        root.theme-index == 5 ? #F7EFE2 : #E6E0E9;

    out property <color> on-surface-variant:
        root.theme-index == 0 ? #A1A1AA :
        root.theme-index == 2 ? #97B8AB :
        root.theme-index == 3 ? #9CB3CE :
        root.theme-index == 4 ? #CBA7B3 :
        root.theme-index == 5 ? #C7B89E : #CAC4D0;

    out property <color> outline:
        root.theme-index == 0 ? #525264 :
        root.theme-index == 2 ? #2F5C4D :
        root.theme-index == 3 ? #3C5A87 :
        root.theme-index == 4 ? #6B384A :
        root.theme-index == 5 ? #665436 : #938F99;

    out property <color> outline-variant:
        root.theme-index == 0 ? #272730 :
        root.theme-index == 2 ? #203D33 :
        root.theme-index == 3 ? #293E5E :
        root.theme-index == 4 ? #492733 :
        root.theme-index == 5 ? #463A25 : #49454F;

    out property <color> primary:
        root.theme-index == 2 ? #6DD5A5 :
        root.theme-index == 3 ? #9EC5FE :
        root.theme-index == 4 ? #FFB2C5 :
        root.theme-index == 5 ? #F7C66F : #D0BCFF;

    out property <color> on-primary:
        root.theme-index == 2 ? #003822 :
        root.theme-index == 3 ? #062C5E :
        root.theme-index == 4 ? #561329 :
        root.theme-index == 5 ? #422C00 : #381E72;

    out property <color> secondary-container:
        root.theme-index == 2 ? #005234 :
        root.theme-index == 3 ? #114488 :
        root.theme-index == 4 ? #78203C :
        root.theme-index == 5 ? #5E4000 : #4A4458;

    out property <color> on-secondary-container: #E8DEF8;
    out property <color> tertiary: #EFB8C8;
    out property <color> error: #F2B8B5;
    out property <color> error-container: #8C1D18;
    out property <color> success: #8CD9A8;
    out property <color> success-container: #1E4D33;
    out property <color> warning: #F5C77E;
    out property <color> warning-container: #5C4100;
    out property <color> info: #A8C7FA;
    out property <color> info-container: #0B3D7A;
    out property <length> card-radius: 12px;
    out property <length> pill-radius: 16px;
}

/// One category line of the Organized Structure box; `kind` picks its color
/// (the order of parser::TokenCategory).
/// One LuCiD VRP region in the region editor: position and size as fractions of the canvas.
export struct HistoryRow {
    label: string,
    when: string,
    starred: bool,
    chars: int,
}

/// One `<lora:…>` of a LoRA box with its first weight, for the − / + chips under the box.
export struct LoraWeight {
    name: string,
    weight: string,
}

/// A row of the 🎨 Palette drawer (`scene::PALETTE`); `title` is empty on a group's continuation rows.
export struct PaletteRow {
    title: string,
    tags: [string],
}

export struct VrpRegion {
    x: float,
    y: float,
    w: float,
    h: float,
}

export struct StructureRow {
    label: string,
    items: string,
    kind: int,
}

/// One character slot inside the horizontal Scene panel (Character 1..4).
export struct ScenePanelChar {
    title: string,
    actions: string,
    has_actions: bool,
    pose_index: int,
    view_index: int,
    angle_index: int,
}

/// One suggested tag on a card, switched on or off by itself (only the "on" ones are added).
export struct CardChip {
    tag: string,
    on: bool,
}

export struct ChangeCardItem {
    id: int,
    badge: string,
    badge_kind: int, // 0 = swap/conflict (amber), 1 = emphasized (green), 2 = bloat/weight (blue), 3 = AI (purple)
    original: string,
    reason: string,
    suggested_alternative: string,
    framing_alternative: string,
    has_framing_alt: bool,
    mode: int, // 0 = Primary Suggestion, 1 = Framing Alternative, 2 = Restore Original
    /// Suggestion cards with several tags: each one can be switched on/off.
    chips: [CardChip],
    /// > 0: this is the folded "N small fixes" card (its reason lists them).
    summary_count: int,
}

component SectionLabel inherits Text {
    font-size: 11px;
    font-weight: 700;
    color: M3.on-surface-variant;
    letter-spacing: 0.4px;
}

// Compact 28px pill button
component PillButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary;
    in property <bool> enabled: true;
    callback clicked();
    height: 28px;
    min-width: label.preferred-width + 22px;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    border-radius: 14px;
    border-width: root.primary ? 0px : 1px;
    border-color: M3.outline-variant;
    background: !root.enabled ? M3.surface-container
        : root.primary ? (ta.has-hover ? M3.primary.brighter(0.12) : M3.primary)
        : (ta.has-hover ? M3.secondary-container : M3.surface-container-high);
    label := Text {
        text: root.text;
        font-size: 12px;
        font-weight: 600;
        color: !root.enabled ? M3.outline : root.primary ? M3.on-primary : M3.on-surface;
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => { root.clicked(); }
    }
}

// Compact Material 3 Filter Chip for the Collapsible Options row
component FilterChip inherits Rectangle {
    in property <string> text;
    in-out property <bool> checked: false;
    in property <bool> enabled: true;
    callback toggled();
    height: 26px;
    min-width: lbl.preferred-width + 20px;
    accessible-role: checkbox;
    accessible-label: root.text;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.checked = !root.checked; root.toggled(); } }
    border-radius: 8px;
    border-width: 1px;
    border-color: !root.enabled ? M3.outline-variant : (root.checked ? M3.primary : M3.outline-variant);
    background: !root.enabled ? M3.surface-container
        : root.checked ? M3.secondary-container : M3.surface-container;
    lbl := Text {
        text: (root.checked ? "✓ " : "") + root.text;
        font-size: 11px;
        font-weight: 600;
        color: !root.enabled ? M3.outline : (root.checked ? M3.primary : M3.on-surface-variant);
    }
    TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => {
            root.checked = !root.checked;
            root.toggled();
        }
    }
}

component M3Card inherits Rectangle {
    clip: true;
    background: M3.surface-container-low;
    border-radius: M3.card-radius;
    border-width: 1px;
    border-color: M3.outline-variant;
}

component Chip inherits Rectangle {
    in property <string> text;
    in property <color> fg;
    in property <color> bg;
    background: bg;
    border-radius: 6px;
    HorizontalLayout {
        padding-left: 7px;
        padding-right: 7px;
        padding-top: 2px;
        padding-bottom: 2px;
        Text {
            text: root.text;
            font-size: 10px;
            font-weight: 700;
            color: root.fg;
        }
    }
}

// Drag handle between two panels. `horizontal-bar` = a bar you drag up/down.
component Splitter inherits Rectangle {
    in property <bool> horizontal-bar: true;
    callback dragged(length);
    border-radius: 4px;
    background: ta.has-hover || ta.pressed ? M3.surface-container-high : transparent;
    Rectangle {
        width: root.horizontal-bar ? (ta.has-hover || ta.pressed ? 80px : 52px) : 4px;
        height: root.horizontal-bar ? 4px : (ta.has-hover || ta.pressed ? 76px : 48px);
        border-radius: 2px;
        background: ta.pressed ? M3.primary : (ta.has-hover ? M3.primary : M3.outline);
    }
    ta := TouchArea {
        mouse-cursor: root.horizontal-bar ? MouseCursor.row-resize : MouseCursor.col-resize;
        moved => {
            if (self.pressed) {
                root.dragged(root.horizontal-bar ? self.mouse-y - self.pressed-y : self.mouse-x - self.pressed-x);
            }
        }
    }
}

// Fixed-size box whose content scrolls up/down with the mouse wheel AND shows a visible scrollbar.
component ScrollBox inherits Rectangle {
    in-out property <length> offset: 0px;
    property <length> max-offset: max(0px, content.preferred-height - root.height);
    clip: true;
    TouchArea {
        scroll-event(e) => {
            if (e.modifiers.shift || e.delta-y == 0 || root.max-offset <= 0) {
                return EventResult.reject;
            }
            root.offset = max(0px, min(root.max-offset, root.offset - e.delta-y));
            return EventResult.accept;
        }
    }
    content := VerticalLayout {
        y: -min(root.offset, root.max-offset);
        width: root.width - 10px;
        height: max(root.height, self.preferred-height);
        alignment: start;
        @children
    }
    // Always-visible vertical scrollbar track + thumb inside Live Scene & Suggestion cards
    Rectangle {
        x: root.width - 7px;
        y: 4px;
        width: 5px;
        height: max(0px, root.height - 8px);
        border-radius: 2.5px;
        background: M3.surface-container;
        Rectangle {
            width: 5px;
            height: root.max-offset > 0
                ? max(22px, parent.height * root.height / max(1px, content.preferred-height))
                : parent.height;
            y: root.max-offset > 0
                ? (parent.height - self.height) * min(root.offset, root.max-offset) / root.max-offset
                : 0px;
            border-radius: 2.5px;
            background: root.max-offset > 0 ? M3.primary : M3.outline-variant;
        }
    }
}

component SceneCard inherits Rectangle {
    in property <string> summary;
    in property <string> details;
    in property <string> issues;
    in property <bool> show-ai-button;
    callback show-ai();
    background: M3.surface-container-high;
    border-radius: 10px;
    border-width: 1px;
    border-color: M3.primary;
    clip: true;
    ScrollBox {
        VerticalLayout {
            padding: 10px;
            spacing: 5px;
            alignment: start;
            HorizontalLayout {
                Chip { text: "AI SCENE ANALYSIS"; fg: M3.on-primary; bg: M3.primary; }
                Rectangle { horizontal-stretch: 1; }
            }
            Text { text: root.summary; font-size: 12px; font-weight: 600; color: M3.on-surface; wrap: word-wrap; }
            if root.details != "" : Text { text: root.details; font-size: 11px; color: M3.on-surface-variant; wrap: word-wrap; }
            if root.issues != "" : Text {
                text: "What's holding it back:\n" + root.issues;
                font-size: 11px;
                color: M3.tertiary;
                wrap: word-wrap;
            }
            if root.show-ai-button : PillButton {
                text: "See AI Improved prompt";
                primary: true;
                clicked => { root.show-ai(); }
            }
        }
    }
}

component ChangeCard inherits Rectangle {
    in property <ChangeCardItem> card;
    callback mode-changed(int, int);
    callback chip-toggled(int, string);
    callback expand-fixes();
    background: M3.surface-container-high;
    border-radius: 10px;
    border-width: 1px;
    border-color: card.badge_kind == 3 ? M3.primary : card.badge_kind == 0 ? M3.warning : (card.badge_kind == 1 ? M3.success : M3.info);
    clip: true;

    ScrollBox {
        VerticalLayout {
            padding: 10px;
            spacing: 5px;
            alignment: start;

            HorizontalLayout {
                spacing: 6px;
                Chip {
                    text: card.badge;
                    fg: card.badge_kind == 3 ? M3.on-primary : card.badge_kind == 0 ? M3.warning : (card.badge_kind == 1 ? M3.success : M3.info);
                    bg: card.badge_kind == 3 ? M3.primary : card.badge_kind == 0 ? M3.warning-container : (card.badge_kind == 1 ? M3.success-container : M3.info-container);
                }
                Text {
                    text: card.summary_count > 0 ? "Already applied" : (card.original == "" ? "New detail" : "Original: \"" + card.original + "\"");
                    font-size: 11px;
                    font-weight: 700;
                    color: M3.tertiary;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
            }

            // the folded small fixes: one button opens them as separate cards
            if card.summary_count > 0 : HorizontalLayout {
                alignment: start;
                PillButton {
                    text: "Show each (" + card.summary_count + ") ▸";
                    clicked => { root.expand-fixes(); }
                }
            }
            if card.chips.length > 0 : Text {
                text: "Pick the tags to add:";
                font-size: 11px;
                font-weight: 600;
                color: M3.success;
            }
            for chip in card.chips : Rectangle {
                height: 22px;
                border-radius: 6px;
                background: chip.on ? M3.secondary-container : transparent;
                border-width: 1px;
                border-color: chip.on ? M3.primary : M3.outline-variant;
                HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    Text {
                        text: (chip.on ? "☑ " : "☐ ") + chip.tag;
                        font-size: 11px;
                        color: chip.on ? M3.primary : M3.on-surface-variant;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
                TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    clicked => { root.chip-toggled(card.id, chip.tag); }
                }
            }
            if card.suggested_alternative != "" && card.chips.length == 0 : Text {
                text: "Suggested: " + card.suggested_alternative;
                font-size: 11px;
                font-weight: 600;
                color: M3.success;
                wrap: word-wrap;
            }

            if card.has_framing_alt : Text {
                text: "Or change framing to: " + card.framing_alternative;
                font-size: 11px;
                color: M3.info;
                wrap: word-wrap;
            }

            if card.summary_count == 0 : HorizontalLayout {
                spacing: 6px;
                alignment: start;
                PillButton {
                    text: card.mode == 0 ? "✓ Applied" : (card.original == "" ? "Add It" : (card.suggested_alternative == "" ? "Remove Tag" : "Use Suggestion"));
                    primary: card.mode == 0;
                    clicked => { root.mode-changed(card.id, 0); }
                }
                PillButton {
                    text: card.original == "" ? (card.mode == 2 ? "✓ Skipped" : "Skip") : (card.mode == 2 ? "✓ Kept Original" : "Keep Original");
                    primary: card.mode == 2;
                    clicked => { root.mode-changed(card.id, 2); }
                }
            }
            if card.has_framing_alt : HorizontalLayout {
                alignment: start;
                PillButton {
                    text: card.mode == 1 ? "✓ Framing Swapped" : "Keep & Swap Framing";
                    primary: card.mode == 1;
                    clicked => { root.mode-changed(card.id, 1); }
                }
            }

            Text {
                text: card.reason;
                font-size: 11px;
                color: M3.on-surface-variant;
                wrap: word-wrap;
            }
        }
    }
}

// Live, rule-based description of the scene the prompt describes (with scrollbar).
component LiveSceneCard inherits Rectangle {
    in property <string> headline;
    in property <string> details;
    in property <string> missing;
    background: M3.surface-container-high;
    border-radius: 10px;
    border-width: 1px;
    border-color: M3.info;
    clip: true;
    ScrollBox {
        VerticalLayout {
            padding: 10px;
            spacing: 5px;
            alignment: start;
            HorizontalLayout {
                Chip { text: "THE SCENE (LIVE SCROLL)"; fg: M3.info; bg: M3.info-container; }
                Rectangle { horizontal-stretch: 1; }
            }
            Text { text: root.headline; font-size: 12px; font-weight: 600; color: M3.on-surface; wrap: word-wrap; }
            if root.details != "" : Text { text: root.details; font-size: 11px; color: M3.on-surface-variant; wrap: word-wrap; }
            if root.missing != "" : Text {
                text: "Not specified: " + root.missing;
                font-size: 11px;
                color: M3.warning;
                wrap: word-wrap;
            }
        }
    }
}

// The scene card, AI analysis and suggestion cards in one horizontally scrolling strip.
/// The reference bar's scan engine, main action and drawer toggles (inline, or on a second row in
/// narrow windows).
component ScanZone inherits HorizontalLayout {
    in-out property <bool> image-use-ai;
    in property <bool> tagger-busy;
    in property <bool> scene-ref-loaded;
    in property <int> app-tab;
    in-out property <int> reference-use-index;
    in property <bool> image-loaded;
    in property <bool> images-pending;
    in property <bool> char1-image-loaded;
    in-out property <bool> image-advanced;
    in-out property <bool> scene-panel-open;
    in property <int> settings-on;
    callback image-mode-changed();
    callback transfer();
    callback auto-scene();
    callback read-image();
    spacing: 8px;
    alignment: end;
    Rectangle { width: 1px; height: 26px; background: M3.outline-variant; }

    // Zone 2: scan engine (+ what the reference is used for, 1 Character tab)
    PillButton {
        text: "⚡ Fast Tagger";
        primary: !root.image-use-ai;
        enabled: !root.tagger-busy;
        clicked => { root.image-use-ai = false; root.image-mode-changed(); }
    }
    PillButton {
        text: "🧠 Combined AI";
        primary: root.image-use-ai;
        enabled: !root.tagger-busy;
        clicked => { root.image-use-ai = true; root.image-mode-changed(); }
    }
    if root.scene-ref-loaded && root.app-tab == 0 : ComboBox {
        width: 160px;
        model: ["Scene & pose", "Identity transfer", "Outfit transfer", "Atmosphere"];
        current-index <=> root.reference-use-index;
    }

    Rectangle { width: 1px; height: 26px; background: M3.outline-variant; }

    // Zone 3: one main action, then the drawers
    PillButton {
        property <bool> transfer: root.scene-ref-loaded && root.app-tab == 0 && root.reference-use-index > 0;
        property <bool> auto-scene: root.scene-ref-loaded && !root.image-use-ai && !root.image-loaded && !root.images-pending && !root.char1-image-loaded;
        primary: true;
        text: root.tagger-busy ? "Scanning…" : (self.transfer ? "⇄ Transfer" : (self.auto-scene ? "⚡ Auto Scene" : "⚡ Scan Image"));
        enabled: !root.tagger-busy && (self.transfer || self.auto-scene || root.image-loaded || root.images-pending || root.scene-ref-loaded || root.char1-image-loaded);
        clicked => {
            if self.transfer {
                root.transfer();
            } else if self.auto-scene {
                root.auto-scene();
            } else {
                root.read-image();
            }
        }
    }
    // the fast per-character pose / scene read of the reference stays reachable when the
    // main button does something else
    if root.scene-ref-loaded && (root.image-use-ai || root.image-loaded || root.images-pending || root.char1-image-loaded || (root.app-tab == 0 && root.reference-use-index > 0)) : PillButton {
        text: "⚡ Auto Scene";
        enabled: !root.tagger-busy;
        clicked => { root.auto-scene(); }
    }
    PillButton {
        property <int> on: root.settings-on;
        text: (root.image-advanced ? "⚙ Settings ▴" : "⚙ Settings ▾") + (self.on > 0 ? " · " + self.on + " on" : "");
        primary: root.image-advanced;
        clicked => { root.image-advanced = !root.image-advanced; }
    }
    PillButton {
        text: root.scene-panel-open ? "Scene Panel ▴" : "Scene Panel ▾";
        primary: root.scene-panel-open;
        clicked => { root.scene-panel-open = !root.scene-panel-open; }
    }
}

/// The Options row's last chips (inline, or on their own row in narrow windows).
component MoreOptionChips inherits HorizontalLayout {
    in-out property <bool> ref-adapter;
    in property <bool> natural-available;
    in-out property <bool> natural;
    in-out property <bool> dynamic;
    in-out property <bool> fit-suggestions;
    in-out property <bool> exaggerated-proportions;
    in property <bool> show-break;
    in property <bool> break-supported;
    in-out property <bool> char-break;
    callback toggled();
    spacing: 6px;
    FilterChip {
        text: "Fit & Dynamics";
        checked <=> root.fit-suggestions;
        toggled => { root.toggled(); }
    }
    FilterChip {
        text: "Exaggerated";
        checked <=> root.exaggerated-proportions;
        toggled => { root.toggled(); }
    }
    FilterChip {
        text: "Ref Adapter";
        checked <=> root.ref-adapter;
        toggled => { root.toggled(); }
    }
    FilterChip {
        text: "Natural NL";
        enabled: root.natural-available;
        checked <=> root.natural;
        toggled => { root.toggled(); }
    }
    FilterChip {
        text: "Dynamic {a|b}";
        checked <=> root.dynamic;
        toggled => { root.toggled(); }
    }
    if root.show-break : FilterChip {
        text: "BREAK Sep";
        enabled: root.break-supported;
        checked <=> root.char-break;
        toggled => { root.toggled(); }
    }
}

/// THEME dropdown and the Ollama host field (top bar; on a second row in narrow windows).
component HostThemeControls inherits HorizontalLayout {
    in-out property <string> host;
    in property <bool> connected;
    in property <bool> busy;
    callback connect();
    callback theme-changed();
    spacing: 8px;
    // Theme Dropdown Box
    SectionLabel {
        text: "THEME:";
        vertical-alignment: center;
    }
    ComboBox {
        width: 150px;
        model: [
            "OLED Pitch Black (#000000)",
            "M3 Deep Violet (Default)",
            "OLED Cyber Emerald",
            "M3 Ocean Blue",
            "M3 Crimson Ember",
            "M3 Mocha Gold"
        ];
        current-index <=> M3.theme-index;
        selected => { root.theme-changed(); }
    }

    // Compact Ollama Host pill
    SectionLabel {
        text: root.connected ? "● Ollama:" : "○ Ollama:";
        color: root.connected ? M3.success : M3.warning;
        vertical-alignment: center;
    }
    Rectangle {
        width: 135px;
        height: 28px;
        border-radius: 8px;
        border-width: 1px;
        border-color: host-input.has-focus ? M3.primary : M3.outline-variant;
        background: M3.surface-container;
        host-input := TextInput {
            x: 8px;
            width: parent.width - 16px;
            height: parent.height;
            vertical-alignment: center;
            single-line: true;
            font-size: 12px;
            color: M3.on-surface;
            text <=> root.host;
            accepted => { root.connect(); }
        }
    }
    PillButton {
        text: root.busy ? "…" : "↻";
        enabled: !root.busy;
        clicked => { root.connect(); }
    }
}

/// Mini preview of the VRP regions (2-4 Characters tabs), in the region editor's colors; click opens it.
component RegionPreview inherits Rectangle {
    in property <[VrpRegion]> regions;
    in property <float> aspect: 1.46;
    callback clicked();
    border-radius: 6px;
    border-width: 1px;
    border-color: pv-ta.has-hover ? M3.primary : M3.outline-variant;
    background: M3.surface-container-high;
    pv-canvas := Rectangle {
        width: min(parent.width - 6px, (parent.height - 6px) * root.aspect);
        height: self.width / root.aspect;
        background: M3.surface;
        clip: true;
        for r[i] in root.regions : Rectangle {
            x: r.x * pv-canvas.width;
            y: r.y * pv-canvas.height;
            width: r.w * pv-canvas.width;
            height: r.h * pv-canvas.height;
            border-width: 1px;
            border-color: i == 0 ? #eb1e1e : i == 1 ? #1e6ef5 : i == 2 ? #28be3c : #f5c814;
            background: i == 0 ? #eb1e1e40 : i == 1 ? #1e6ef540 : i == 2 ? #28be3c40 : #f5c81440;
        }
    }
    pv-ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// A tab in the card strip's filter row ("Conflicts 3").
component FilterTab inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    callback clicked();
    height: 22px;
    min-width: tl.preferred-width + 14px;
    border-radius: 11px;
    accessible-role: button;
    accessible-label: root.text;
    background: root.selected ? M3.secondary-container : (ta.has-hover ? M3.surface-container-high : transparent);
    border-width: 1px;
    border-color: root.selected ? M3.primary : M3.outline-variant;
    tl := Text {
        text: root.text;
        font-size: 11px;
        font-weight: root.selected ? 700 : 500;
        color: root.selected ? M3.primary : M3.on-surface-variant;
    }
    ta := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
}

component CardsPanel inherits M3Card {
    in property <[ChangeCardItem]> cards;
    /// 0 All, 1 Conflicts, 2 Fixes, 3 Suggestions, 4 AI; counts in the same order.
    in property <int> card-filter;
    in property <[int]> filter-counts: [0, 0, 0, 0, 0];
    in property <bool> ideas-enabled;
    in property <bool> ideas-busy;
    callback filter-changed(int);
    callback chip-toggled(int, string);
    callback expand-fixes();
    callback ideas();
    in property <string> live-headline;
    in property <string> live-details;
    in property <string> live-missing;
    in property <string> scene-summary;
    in property <string> scene-details;
    in property <string> scene-issues;
    in property <bool> show-ai-button;
    callback mode-changed(int, int);
    callback show-ai();
    border-color: M3.outline-variant;

    VerticalLayout {
        padding: 8px;
        spacing: 6px;

        HorizontalLayout {
            spacing: 8px;
            Text {
                text: "⚡ SCENE & SUGGESTIONS (SCROLLABLE)" + (root.cards.length > 0 ? " · " + root.cards.length : "");
                font-size: 11px;
                font-weight: 700;
                color: M3.warning;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
            for label[i] in ["All", "Conflicts", "Fixes", "Suggestions", "AI"] : FilterTab {
                text: label + " " + (root.filter-counts[i]);
                selected: root.card-filter == i;
                clicked => { root.filter-changed(i); }
            }
            PillButton {
                text: root.ideas-busy ? "💡 Thinking…" : "💡 Ideas";
                enabled: root.ideas-enabled && !root.ideas-busy;
                clicked => { root.ideas(); }
            }
        }

        if root.live-headline == "" && root.cards.length == 0 : Text {
            vertical-stretch: 1;
            text: "Paste a prompt below (or use From Image… / Scene Ref…) to see the live scene breakdown, conflicts, and fixes.";
            font-size: 12px;
            color: M3.on-surface-variant;
            wrap: word-wrap;
            vertical-alignment: center;
            horizontal-alignment: center;
        }

        if root.live-headline != "" || root.cards.length > 0 : row := ScrollView {
            vertical-stretch: 1;
            HorizontalLayout {
                height: max(80px, row.visible-height - 10px);
                spacing: 8px;
                alignment: start;
                if root.live-headline != "" : LiveSceneCard {
                    width: 360px;
                    headline: root.live-headline;
                    details: root.live-details;
                    missing: root.live-missing;
                }
                if root.scene-summary != "" : SceneCard {
                    width: 350px;
                    summary: root.scene-summary;
                    details: root.scene-details;
                    issues: root.scene-issues;
                    show-ai-button: root.show-ai-button;
                    show-ai => { root.show-ai(); }
                }
                for card in root.cards : ChangeCard {
                    width: 295px;
                    card: card;
                    mode-changed(id, mode) => { root.mode-changed(id, mode); }
                    chip-toggled(id, tag) => { root.chip-toggled(id, tag); }
                    expand-fixes => { root.expand-fixes(); }
                }
            }
        }
    }
}

/// Editable Character Card containing:
///   1) Top pane: Character Prompt (multiline TextEdit)
///   2) Middle: Independent Horizontal Splitter (drag up/down per character)
///   3) Bottom pane: Character LoRA & Trigger Words vertical multiline TextEdit
component CharacterCard inherits M3Card {
    in property <string> title;
    in property <string> stats;
    /// More than one CLIP chunk: the token readout turns amber.
    in property <bool> stats-warn;
    in property <string> lora-title: "LORA & TRIGGER WORDS";
    in-out property <string> text;
    in-out property <string> lora-text;
    in-out property <float> prompt-ratio: 0.68;
    /// Trigger words from the LoRA files' training tags (`lora_meta`), not yet in the LoRA box.
    in property <[string]> lora-suggestions: [];
    /// The box's `<lora:…>` weights: a chip each with − / + (±0.05, `lora_meta::step_weight`).
    in property <[LoraWeight]> lora-weights: [];
    callback lora-step(int, float);
    callback edited();
    callback clear_requested();
    /// "+ Quality" (character 1 / Before only; hidden for Flux): the checkpoint's quality tags in front.
    in property <bool> quality-button: false;
    callback add-quality();
    border-color: M3.outline;

    VerticalLayout {
        padding: 8px;
        spacing: 2px;

        // Top: Character Prompt
        VerticalLayout {
            vertical-stretch: root.prompt-ratio;
            min-height: 72px;
            spacing: 4px;
            HorizontalLayout {
                spacing: 6px;
                // the title and stats shorten with "…" on a narrow window, so the buttons stay visible
                Text { text: root.title; font-size: 11px; font-weight: 700; color: M3.error; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; min-width: 40px; }
                Text { text: root.stats; font-size: 11px; color: root.stats-warn ? M3.warning : M3.on-surface-variant; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; min-width: 0px; horizontal-alignment: right; }
                if root.quality-button : PillButton {
                    text: "+ Quality";
                    clicked => { root.add-quality(); }
                }
                if root.text != "" || root.lora-text != "" : PillButton {
                    text: "✕ Clear";
                    clicked => {
                        root.text = "";
                        root.lora-text = "";
                        root.clear_requested();
                        root.edited();
                    }
                }
            }
            TextEdit {
                vertical-stretch: 1;
                min-height: 40px;
                text <=> root.text;
                wrap: word-wrap;
                font-size: 13px;
                edited => { root.edited(); }
            }
        }

        // Independent Horizontal Splitter between Character Prompt and Character LoRA box
        Splitter {
            horizontal-bar: true;
            height: 8px;
            dragged(d) => {
                root.prompt-ratio = max(0.25, min(0.84, root.prompt-ratio + d / max(1px, root.height)));
            }
        }

        // Bottom: Vertical Multiline LoRA & Trigger Words Field for this Character
        VerticalLayout {
            vertical-stretch: 1.0 - root.prompt-ratio;
            min-height: 36px;
            spacing: 2px;
            HorizontalLayout {
                spacing: 6px;
                Text { text: root.lora-title; font-size: 10px; font-weight: 700; color: M3.primary; }
                Rectangle { horizontal-stretch: 1; }
                Text { text: "Independent height"; font-size: 10px; color: M3.on-surface-variant; }
            }
            TextEdit {
                vertical-stretch: 1;
                // the weight / trigger chip rows below may not squeeze the box to nothing
                min-height: 30px;
                text <=> root.lora-text;
                wrap: word-wrap;
                font-size: 12px;
                placeholder-text: "e.g. <lora:character:0.8>, trigger words...";
                edited => { root.edited(); }
            }
            // weight chips: "name 0.8 [−][+]", a click rewrites the box (Rust side)
            if root.lora-weights.length > 0 : HorizontalLayout {
                spacing: 4px;
                alignment: start;
                Text { text: "Weight:"; font-size: 10px; color: M3.on-surface-variant; vertical-alignment: center; }
                for lw[i] in root.lora-weights : Rectangle {
                    height: 20px;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: M3.outline-variant;
                    background: M3.surface-container-high;
                    HorizontalLayout {
                        padding-left: 7px;
                        padding-right: 2px;
                        spacing: 2px;
                        Text { text: lw.name; font-size: 10px; color: M3.on-surface-variant; vertical-alignment: center; overflow: elide; max-width: 110px; }
                        Text { text: lw.weight; font-size: 10px; font-weight: 700; color: M3.primary; vertical-alignment: center; }
                        Rectangle {
                            width: 16px;
                            border-radius: 8px;
                            background: minus-ta.has-hover ? M3.secondary-container : transparent;
                            accessible-role: button;
                            accessible-label: "LoRA weight −";
                            Text { text: "−"; font-size: 11px; color: M3.primary; }
                            minus-ta := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.lora-step(i, -0.05); } }
                        }
                        Rectangle {
                            width: 16px;
                            border-radius: 8px;
                            background: plus-ta.has-hover ? M3.secondary-container : transparent;
                            accessible-role: button;
                            accessible-label: "LoRA weight +";
                            Text { text: "+"; font-size: 11px; color: M3.primary; }
                            plus-ta := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.lora-step(i, 0.05); } }
                        }
                    }
                }
            }
            // "+ tag" chips: a click appends the tag to this LoRA box (never added on their own)
            if root.lora-suggestions.length > 0 : HorizontalLayout {
                spacing: 4px;
                alignment: start;
                Text { text: "Triggers:"; font-size: 10px; color: M3.on-surface-variant; vertical-alignment: center; }
                for tag in root.lora-suggestions : Rectangle {
                    height: 20px;
                    min-width: chip-label.preferred-width + 14px;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: M3.outline-variant;
                    background: chip-ta.has-hover ? M3.secondary-container : M3.surface-container-high;
                    chip-label := Text { text: "+ " + tag; font-size: 10px; color: M3.primary; }
                    chip-ta := TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        clicked => {
                            root.lora-text = root.lora-text == "" ? tag : root.lora-text + ", " + tag;
                            root.edited();
                        }
                    }
                }
            }
        }
    }
}

/// Dynamic Multi-Character Workspace + Bottom After/Negative Row:
/// - 1 Character: [Char 1 + LoRA] | [Synced V-Splitter] | [Organized Structure]
/// - 2 Characters (2x1): [Char 1 + LoRA] | [Synced V-Splitter] | [Char 2 + LoRA]
/// - 3 Characters (3x1): [Char 1 + LoRA] | [V-Split 1] | [Char 2 + LoRA] | [V-Split 2] | [Char 3 + LoRA]
/// - 4 Characters (2x2):
///     Top Row:    [Char 1 + LoRA] | [Unified 4-Char V-Splitter] | [Char 2 + LoRA]
///     Middle:     [Draggable Horizontal Splitter]
///     Bottom Row: [Char 3 + LoRA] | [Unified 4-Char V-Splitter] | [Char 4 + LoRA]
component PromptColumn inherits VerticalLayout {
    in-out property <string> raw-prompt;
    in-out property <string> lora-tags;
    in property <string> before-stats;
    in property <string> after-stats;
    in property <bool> before-stats-warn;
    in property <bool> after-stats-warn;
    in property <bool> char2-stats-warn;
    in property <bool> char3-stats-warn;
    in property <bool> char4-stats-warn;
    in property <string> condensed-plain;
    in property <int> after-view;
    in property <bool> ai-improved-available;
    in property <bool> dynamic-enabled;
    in property <string> dynamic-note;
    /// After shows a 🎲 Roll of the Dynamic template (one pick per group), not the template.
    in property <bool> rolled: false;
    in property <string> ai-dropped;
    in property <string> substituted-list;
    in property <string> added-list;
    in property <string> category-breakdown;
    in property <[StructureRow]> structure-rows;
    /// 1 to 4 characters (the tab).
    in property <int> char-count: 1;
    in-out property <string> char2-prompt;
    in-out property <string> char3-prompt;
    in-out property <string> char4-prompt;
    in-out property <string> char2-lora-tags;
    in-out property <string> char3-lora-tags;
    in-out property <string> char4-lora-tags;
    in property <string> char2-stats;
    in property <string> char3-stats;
    in property <string> char4-stats: "";
    in property <[string]> lora-suggest-c1: [];
    in property <[string]> lora-suggest-c2: [];
    in property <[string]> lora-suggest-c3: [];
    in property <[string]> lora-suggest-c4: [];
    in property <[LoraWeight]> lora-weights-c1: [];
    in property <[LoraWeight]> lora-weights-c2: [];
    in property <[LoraWeight]> lora-weights-c3: [];
    in property <[LoraWeight]> lora-weights-c4: [];
    /// A weight chip's − / + (character, LoRA index in that box, delta).
    callback lora-step(int, int, float);
    /// Share of the height the top workspace row gets vs bottom After row.
    in-out property <float> before-ratio;
    /// Shared right-column width for 1-Char, 2-Char, and Bottom (After | Negative) so their vertical sliders move together!
    in-out property <length> side-width;
    /// Independent ratios for 3-Char (3x1), 4-Char (2x2), and per-character LoRA boxes:
    in-out property <float> char3-col1-ratio: 0.333;
    in-out property <float> char3-col2-ratio: 0.333;
    in-out property <float> char4-left-ratio: 0.50;
    in-out property <float> char4-top-ratio: 0.50;
    in-out property <float> lora-ratio-c1: 0.68;
    in-out property <float> lora-ratio-c2: 0.68;
    in-out property <float> lora-ratio-c3: 0.68;
    in-out property <float> lora-ratio-c4: 0.68;

    in property <bool> quality-available: false;
    callback add-quality();
    in property <string> negative-plain;
    in property <string> negative-note;
    in property <bool> negative-available;
    /// The negative box open; collapsed it is a slim strip under After, which then takes the full width.
    in-out property <bool> negative-expanded: true;
    in property <string> negative-tokens;
    /// Zen mode: the output header row is hidden (After keeps its own Copy).
    in property <bool> zen: false;
    in-out property <bool> output-collapsed: false;
    /// Copy format (condenser::ExportFormat): 0 ComfyUI, 1 WebUI, 2 NovelAI, 3 Plain.
    in-out property <int> export-index: 0;
    callback edited();
    callback after-view-changed(int);
    callback roll();
    callback copy();
    callback copy-section-blocks();
    callback copy-negative();

    spacing: 0px;

    // =========================================================================
    // TOP WORKSPACE AREA (1, 2x1, 3x1, or 2x2 Grid)
    // =========================================================================

    // ---- MODE 1 & MODE 2 (1 Character OR 2 Characters 2x1 Side-by-Side; V-Slider synced with Bottom Row)
    if root.char-count == 1 || root.char-count == 2 : HorizontalLayout {
        vertical-stretch: root.before-ratio;
        spacing: 0px;

        CharacterCard {
            horizontal-stretch: 1;
            min-width: 200px;
            title: root.char-count == 2 ? "CHARACTER 1 (LEFT) — PROMPT" : "BEFORE — RAW COMFYUI PROMPT";
            lora-title: root.char-count == 2 ? "LORA C1 (LEFT)" : "LORA & TRIGGER WORDS";
            stats: root.before-stats;
            stats-warn: root.before-stats-warn;
            text <=> root.raw-prompt;
            quality-button: root.quality-available;
            add-quality => { root.add-quality(); }
            lora-text <=> root.lora-tags;
            lora-suggestions: root.lora-suggest-c1;
            lora-weights: root.lora-weights-c1;
            lora-step(i, d) => { root.lora-step(0, i, d); }
            prompt-ratio <=> root.lora-ratio-c1;
            edited => { root.edited(); }
        }

        // Synced Vertical Splitter (moves 1-Char, 2-Char, and Bottom After/Negative together)
        Splitter {
            horizontal-bar: false;
            width: 10px;
            dragged(d) => {
                root.side-width = max(180px, min(root.side-width - d, root.width - 260px));
            }
        }

        if root.char-count == 1 : M3Card {
            preferred-width: root.side-width;
            min-width: 180px;
            horizontal-stretch: 0;
            border-color: M3.info-container;
            VerticalLayout {
                padding: 10px;
                spacing: 6px;
                Text {
                    text: "ORGANIZED STRUCTURE";
                    font-size: 11px;
                    font-weight: 700;
                    color: M3.info;
                }
                structure-scroll := ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        width: structure-scroll.visible-width;
                        padding: 2px;
                        spacing: 6px;
                        if root.structure-rows.length == 0 : Text {
                            text: "No tokens parsed yet.";
                            font-size: 12px;
                            color: M3.on-surface-variant;
                        }
                        // each category in its own color; the tags stay selectable
                        for row in root.structure-rows : VerticalLayout {
                            spacing: 1px;
                            Text {
                                text: row.label;
                                font-size: 11px;
                                font-weight: 700;
                                color: row.kind == 0 ? M3.warning
                                    : row.kind == 1 ? M3.primary
                                    : row.kind == 2 ? M3.success
                                    : row.kind == 3 ? M3.info
                                    : row.kind == 4 ? M3.tertiary
                                    : row.kind == 5 ? M3.error
                                    : row.kind == 6 ? M3.on-surface-variant
                                    : row.kind == 7 ? M3.success
                                    : M3.primary;
                            }
                            TextInput {
                                text: row.items;
                                read-only: true;
                                single-line: false;
                                wrap: word-wrap;
                                font-size: 12px;
                                color: M3.on-surface;
                                selection-background-color: #D0BCFF99;
                            }
                        }
                    }
                }
            }
        }

        if root.char-count == 2 : CharacterCard {
            preferred-width: root.side-width;
            min-width: 180px;
            horizontal-stretch: 0;
            title: "CHARACTER 2 (RIGHT) — PROMPT";
            lora-title: "LORA C2 (RIGHT)";
            stats: root.char2-stats;
            stats-warn: root.char2-stats-warn;
            text <=> root.char2-prompt;
            lora-text <=> root.char2-lora-tags;
            lora-suggestions: root.lora-suggest-c2;
            lora-weights: root.lora-weights-c2;
            lora-step(i, d) => { root.lora-step(1, i, d); }
            prompt-ratio <=> root.lora-ratio-c2;
            edited => { root.edited(); }
        }
    }

    // ---- MODE 3: 3 CHARACTERS (3 x 1 Side-by-Side Grid with 2 Adjustable Vertical Splitters)
    if root.char-count == 3 : HorizontalLayout {
        vertical-stretch: root.before-ratio;
        spacing: 0px;

        CharacterCard {
            horizontal-stretch: root.char3-col1-ratio;
            min-width: 160px;
            title: "CHARACTER 1 (LEFT)";
            lora-title: "LORA C1";
            stats: root.before-stats;
            stats-warn: root.before-stats-warn;
            text <=> root.raw-prompt;
            quality-button: root.quality-available;
            add-quality => { root.add-quality(); }
            lora-text <=> root.lora-tags;
            lora-suggestions: root.lora-suggest-c1;
            lora-weights: root.lora-weights-c1;
            lora-step(i, d) => { root.lora-step(0, i, d); }
            prompt-ratio <=> root.lora-ratio-c1;
            edited => { root.edited(); }
        }

        Splitter {
            horizontal-bar: false;
            width: 10px;
            dragged(d) => {
                root.char3-col1-ratio = max(0.18, min(0.60, root.char3-col1-ratio + d / max(1px, root.width)));
            }
        }

        CharacterCard {
            horizontal-stretch: root.char3-col2-ratio;
            min-width: 160px;
            title: "CHARACTER 2 (CENTER)";
            lora-title: "LORA C2";
            stats: root.char2-stats;
            stats-warn: root.char2-stats-warn;
            text <=> root.char2-prompt;
            lora-text <=> root.char2-lora-tags;
            lora-suggestions: root.lora-suggest-c2;
            lora-weights: root.lora-weights-c2;
            lora-step(i, d) => { root.lora-step(1, i, d); }
            prompt-ratio <=> root.lora-ratio-c2;
            edited => { root.edited(); }
        }

        Splitter {
            horizontal-bar: false;
            width: 10px;
            dragged(d) => {
                root.char3-col2-ratio = max(0.18, min(0.60, root.char3-col2-ratio + d / max(1px, root.width)));
            }
        }

        CharacterCard {
            horizontal-stretch: max(0.18, 1.0 - root.char3-col1-ratio - root.char3-col2-ratio);
            min-width: 160px;
            title: "CHARACTER 3 (RIGHT)";
            lora-title: "LORA C3";
            stats: root.char3-stats;
            stats-warn: root.char3-stats-warn;
            text <=> root.char3-prompt;
            lora-text <=> root.char3-lora-tags;
            lora-suggestions: root.lora-suggest-c3;
            lora-weights: root.lora-weights-c3;
            lora-step(i, d) => { root.lora-step(2, i, d); }
            prompt-ratio <=> root.lora-ratio-c3;
            edited => { root.edited(); }
        }
    }

    // ---- MODE 4: 4 CHARACTERS (2 x 2 Grid with Unified Vertical Slider + Horizontal Slider)
    if root.char-count == 4 : g4 := VerticalLayout {
        vertical-stretch: root.before-ratio;
        spacing: 0px;

        // Top Row of 2x2 (Character 1 | Unified V-Splitter | Character 2)
        HorizontalLayout {
            vertical-stretch: root.char4-top-ratio;
            spacing: 0px;

            CharacterCard {
                horizontal-stretch: root.char4-left-ratio;
                min-width: 180px;
                title: "CHARACTER 1 (TOP-LEFT)";
                lora-title: "LORA C1";
                stats: root.before-stats;
                stats-warn: root.before-stats-warn;
                text <=> root.raw-prompt;
            quality-button: root.quality-available;
            add-quality => { root.add-quality(); }
                lora-text <=> root.lora-tags;
                lora-suggestions: root.lora-suggest-c1;
                lora-weights: root.lora-weights-c1;
                lora-step(i, d) => { root.lora-step(0, i, d); }
                prompt-ratio <=> root.lora-ratio-c1;
                edited => { root.edited(); }
            }

            // Unified 4-Char Vertical Splitter (Top half — locked with Bottom half via char4-left-ratio)
            Splitter {
                horizontal-bar: false;
                width: 10px;
                dragged(d) => {
                    root.char4-left-ratio = max(0.20, min(0.80, root.char4-left-ratio + d / max(1px, root.width)));
                }
            }

            CharacterCard {
                horizontal-stretch: 1.0 - root.char4-left-ratio;
                min-width: 180px;
                title: "CHARACTER 2 (TOP-RIGHT)";
                lora-title: "LORA C2";
                stats: root.char2-stats;
                stats-warn: root.char2-stats-warn;
                text <=> root.char2-prompt;
                lora-text <=> root.char2-lora-tags;
                lora-suggestions: root.lora-suggest-c2;
                lora-weights: root.lora-weights-c2;
                lora-step(i, d) => { root.lora-step(1, i, d); }
                prompt-ratio <=> root.lora-ratio-c2;
                edited => { root.edited(); }
            }
        }

        // Horizontal Splitter between Row 1 (Chars 1-2) and Row 2 (Chars 3-4)
        Splitter {
            horizontal-bar: true;
            height: 10px;
            dragged(d) => {
                root.char4-top-ratio = max(0.25, min(0.75, root.char4-top-ratio + d / max(1px, g4.height)));
            }
        }

        // Bottom Row of 2x2 (Character 3 | Unified V-Splitter | Character 4)
        HorizontalLayout {
            vertical-stretch: 1.0 - root.char4-top-ratio;
            spacing: 0px;

            CharacterCard {
                horizontal-stretch: root.char4-left-ratio;
                min-width: 180px;
                title: "CHARACTER 3 (BOTTOM-LEFT)";
                lora-title: "LORA C3";
                stats: root.char3-stats;
                stats-warn: root.char3-stats-warn;
                text <=> root.char3-prompt;
                lora-text <=> root.char3-lora-tags;
                lora-suggestions: root.lora-suggest-c3;
                lora-weights: root.lora-weights-c3;
                lora-step(i, d) => { root.lora-step(2, i, d); }
                prompt-ratio <=> root.lora-ratio-c3;
                edited => { root.edited(); }
            }

            // Unified 4-Char Vertical Splitter (Bottom half — locked with Top half via char4-left-ratio)
            Splitter {
                horizontal-bar: false;
                width: 10px;
                dragged(d) => {
                    root.char4-left-ratio = max(0.20, min(0.80, root.char4-left-ratio + d / max(1px, root.width)));
                }
            }

            CharacterCard {
                horizontal-stretch: 1.0 - root.char4-left-ratio;
                min-width: 180px;
                title: "CHARACTER 4 (BOTTOM-RIGHT)";
                lora-title: "LORA C4";
                stats: root.char4-stats;
                stats-warn: root.char4-stats-warn;
                text <=> root.char4-prompt;
                lora-text <=> root.char4-lora-tags;
                lora-suggestions: root.lora-suggest-c4;
                lora-weights: root.lora-weights-c4;
                lora-step(i, d) => { root.lora-step(3, i, d); }
                prompt-ratio <=> root.lora-ratio-c4;
                edited => { root.edited(); }
            }
        }
    }

    // Horizontal Splitter between Character Workspace and After/Negative Output Row
    Splitter {
        height: 10px;
        dragged(d) => {
            root.before-ratio = max(0.20, min(0.82, root.before-ratio + d / max(1px, root.height)));
        }
    }

    // =========================================================================
    // UNIFIED OUTPUT ROW: COPY PROMPT & NEGATIVE ON SAME LINE + 1 COLLAPSE BUTTON
    // =========================================================================
    if !root.zen : Rectangle {
        background: M3.surface-container;
        border-radius: 8px;
        border-width: 1px;
        border-color: M3.outline-variant;
        HorizontalLayout {
            padding-left: 10px;
            padding-right: 10px;
            padding-top: 4px;
            padding-bottom: 4px;
            spacing: 8px;
            alignment: center;

            Text {
                text: "📋 FINAL COMFYUI OUTPUT & NEGATIVE";
                font-size: 11px;
                font-weight: 700;
                color: M3.on-surface;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }

            Rectangle { horizontal-stretch: 1; }

            // Copy Prompt Button
            PillButton {
                text: "📋 Copy Prompt";
                primary: root.after-view != 3 && root.after-view != 4;
                clicked => { root.copy(); }
            }

            // Copy Section Blocks Button
            PillButton {
                text: root.after-view == 4 ? "📦 Copy AI Blocks" : "📦 Copy Section Blocks";
                primary: root.after-view == 3 || root.after-view == 4;
                clicked => { root.copy-section-blocks(); }
            }

            // Copy Negative Button (On the exact same line!)
            if root.negative-available : PillButton {
                text: "🚫 Copy Negative";
                clicked => { root.copy-negative(); }
            }

            // Single Unified Toggle to Collapse / Expand Both Text Boxes
            PillButton {
                text: root.output-collapsed ? "Show Prompts ▾" : "Collapse Prompts ▴";
                primary: !root.output-collapsed;
                clicked => { root.output-collapsed = !root.output-collapsed; }
            }
        }
    }

    // =========================================================================
    // BOTTOM WORKSPACE AREA: AFTER OUTPUT | [SYNCED V-SPLITTER] | RECOMMENDED NEGATIVE
    // =========================================================================
    if !root.output-collapsed : HorizontalLayout {
        vertical-stretch: 1.0 - root.before-ratio;
        min-height: 64px;
        spacing: 0px;
        VerticalLayout {
            horizontal-stretch: 1;
            min-width: 220px;
            M3Card {
                min-height: 64px;
                border-color: M3.success-container;
                VerticalLayout {
                    padding: 10px;
                    spacing: 5px;
                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: root.after-view == 4 ? "AFTER — AI SECTION BLOCKS (DEEP AI SCAN)" : (root.after-view == 3 ? "AFTER — SECTION BLOCKS (MODULAR LAYOUT)" : (root.after-view == 2 ? (root.rolled ? "AFTER — ROLLED PREVIEW (ONE PICK PER GROUP)" : "AFTER — DYNAMIC PROMPT") : (root.after-view == 1 ? "AFTER — AI IMPROVED" : "AFTER — CONDENSED & CONFLICT-FREE")));
                            font-size: 11px;
                            font-weight: 700;
                            color: M3.success;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                        HorizontalLayout {
                            spacing: 4px;
                            PillButton {
                                text: "Rule-based";
                                primary: root.after-view == 0;
                                clicked => { root.after-view-changed(0); }
                            }
                            PillButton {
                                text: "Section Blocks";
                                primary: root.after-view == 3;
                                clicked => { root.after-view-changed(3); }
                            }
                            if root.ai-improved-available : PillButton {
                                text: "AI Improved";
                                primary: root.after-view == 1;
                                clicked => { root.after-view-changed(1); }
                            }
                            if root.ai-improved-available : PillButton {
                                text: "AI Section Blocks";
                                primary: root.after-view == 4;
                                clicked => { root.after-view-changed(4); }
                            }
                            if root.dynamic-enabled : PillButton {
                                text: "Dynamic";
                                primary: root.after-view == 2;
                                clicked => { root.after-view-changed(2); }
                            }
                            if root.dynamic-enabled && root.after-view == 2 : PillButton {
                                text: "🎲 Roll";
                                primary: root.rolled;
                                clicked => { root.roll(); }
                            }
                        }
                        Text { text: root.after-stats; font-size: 11px; color: root.after-stats-warn ? M3.warning : M3.success; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; horizontal-alignment: right; }
                        ComboBox {
                            width: 112px;
                            model: ["ComfyUI", "WebUI", "NovelAI", "Plain"];
                            current-index <=> root.export-index;
                        }
                        PillButton {
                            text: (root.after-view == 3 || root.after-view == 4) ? "📋 Copy Blocks" : "📋 Copy";
                            primary: true;
                            clicked => {
                                if root.after-view == 3 || root.after-view == 4 {
                                    root.copy-section-blocks();
                                } else {
                                    root.copy();
                                }
                            }
                        }
                    }
                    after-scroll := ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            width: after-scroll.visible-width;
                            padding: 4px;
                            TextInput {
                                text: root.condensed-plain;
                                read-only: true;
                                single-line: false;
                                wrap: word-wrap;
                                font-size: 13px;
                                color: M3.on-surface;
                                selection-background-color: #D0BCFF99;
                            }
                        }
                    }
                    if root.after-view == 1 && root.ai-dropped != "" : Text {
                        text: "Dropped from your prompt: " + root.ai-dropped + " — copy them back if you want them.";
                        font-size: 11px;
                        color: M3.tertiary;
                        wrap: word-wrap;
                    }
                    if root.after-view == 2 && root.dynamic-note != "" : Text {
                        text: root.dynamic-note;
                        font-size: 11px;
                        color: M3.info;
                        wrap: word-wrap;
                    }
                    if root.substituted-list != "" : Text {
                        text: "Substituted: " + root.substituted-list;
                        font-size: 11px;
                        color: M3.warning;
                        wrap: word-wrap;
                    }
                    if root.added-list != "" : Text {
                        text: "Added: " + root.added-list;
                        font-size: 11px;
                        color: M3.success;
                        wrap: word-wrap;
                    }
                }
            }
        }
        // Synced Vertical Splitter (shares root.side-width with 1-Char and 2-Char)
        if root.negative-expanded && root.negative-available : Splitter {
            horizontal-bar: false;
            width: 10px;
            dragged(d) => {
                root.side-width = max(180px, min(root.side-width - d, root.width - 260px));
            }
        }
        if root.negative-expanded && root.negative-available : VerticalLayout {
            preferred-width: root.side-width;
            min-width: 180px;
            horizontal-stretch: 0;
            M3Card {
                min-height: 64px;
                border-color: M3.error-container;
                VerticalLayout {
                    padding: 10px;
                    spacing: 5px;
                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: "RECOMMENDED NEGATIVE";
                            font-size: 11px;
                            font-weight: 700;
                            color: M3.error;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        if root.negative-available : PillButton {
                            text: "📋 Copy";
                            clicked => { root.copy-negative(); }
                        }
                        PillButton {
                            text: "▴";
                            clicked => { root.negative-expanded = false; }
                        }
                    }
                    neg-scroll := ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            width: neg-scroll.visible-width;
                            padding: 4px;
                            TextInput {
                                text: root.negative-plain;
                                read-only: true;
                                single-line: false;
                                wrap: word-wrap;
                                font-size: 12px;
                                color: M3.on-surface-variant;
                                selection-background-color: #D0BCFF99;
                            }
                        }
                    }
                    Text {
                        text: root.negative-note;
                        font-size: 11px;
                        color: M3.on-surface-variant;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }
    // collapsed negative (or Flux, which has none): one slim strip under After
    if !root.output-collapsed && !(root.negative-expanded && root.negative-available) : Rectangle {
        height: 26px;
        border-radius: 8px;
        border-width: 1px;
        border-color: M3.error-container;
        background: neg-strip-ta.has-hover && root.negative-available ? M3.surface-container-high : M3.surface-container;
        HorizontalLayout {
            padding-left: 10px;
            padding-right: 10px;
            spacing: 8px;
            Text {
                text: root.negative-available ? "▸ Negative · " + root.negative-tokens : "Negative · not used by this checkpoint";
                font-size: 11px;
                font-weight: 700;
                color: root.negative-available ? M3.error : M3.on-surface-variant;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
        }
        neg-strip-ta := TouchArea {
            enabled: root.negative-available;
            clicked => { root.negative-expanded = true; }
        }
    }
}

export component AppWindow inherits Window {
    title: "ComfyUI Prompt Condenser & Framing Conflict Scanner";
    preferred-width: 1380px;
    preferred-height: 900px;
    min-width: 800px;
    min-height: 560px;
    background: M3.surface;

    // Theme & UI state
    in-out property <int> theme_index <=> M3.theme-index;
    in-out property <bool> options_expanded: false;
    /// Recommended Negative open (saved) / Zen mode (saved: View, Options and Folders rows and the
    /// output header hidden).
    in-out property <bool> negative_expanded: false;
    in-out property <bool> zen_mode: false;
    in-out property <string> negative_tokens: "";
    /// Status pill: "✓ Clean", "N conflicts" or "N fixes" (`render::issue_summary`); the app version.
    in-out property <string> issue_summary: "✓ Clean";
    in-out property <string> app_version: "";
    /// Mini region preview (2-4 Characters tabs; `render::push_vrp_preview`).
    in-out property <[VrpRegion]> vrp_preview: [];
    in-out property <float> vrp_preview_aspect: 1.46;
    /// The cards strip opened from its "clean" banner (not saved).
    in-out property <bool> cards_peek: false;
    /// Prompt history (`history.rs`): the overlay, its rows (newest first) and the pill's count.
    in-out property <bool> history_open: false;
    /// The 🎨 Palette drawer: lighting / atmosphere / style chips; a click appends the tag to the Scene box
    /// (2-4 Characters) or Before (1 Character).
    in-out property <bool> palette_open: false;
    in-out property <[PaletteRow]> palette_rows: [];
    callback palette_tag_clicked(string);
    in-out property <[HistoryRow]> history_rows: [];
    in-out property <int> history_count: 0;
    callback history_open_requested();
    callback history_stash_requested();
    callback history_star_toggled(int);
    callback history_restore_requested(int);
    /// Narrow window (the minimum is 800 px): the top bar and the reference bar wrap onto a second row.
    /// Set from Rust (`settings::update_narrow`): binding it to root.width loops through the window's
    /// own layout info.
    in-out property <bool> narrow: false;
    property <[string]> checkpoint-names: ["Anima", "Pony V6", "Illustrious", "SDXL", "SD 1.5", "Flux"];
    property <bool> cards-empty: root.change_cards.length == 0 && root.scene_summary == "";
    /// Copy format next to After's Copy (saved; condenser::ExportFormat order).
    in-out property <int> export_index: 0;
    /// Option chips that differ from their defaults (shown on the collapsed Options toggle).
    property <int> options_changed: (root.cleanup_enabled ? 0 : 1) + (root.resolve_conflicts_enabled ? 0 : 1)
        + (root.clamp_weights_enabled ? 0 : 1) + (root.arranged_enabled ? 1 : 0) + (root.ref_adapter_mode ? 1 : 0)
        + (root.natural_enabled ? 1 : 0) + (root.dynamic_enabled ? 1 : 0)
        + (root.app_tab >= 1 && !root.char_break_enabled ? 1 : 0);
    /// "✓ Copied" toast after a copy button (fades out).
    property <bool> toast-on: false;
    function show-copied() {
        root.toast-on = true;
        toast-timer.running = true;
    }
    callback theme_changed();

    // Dropdowns
    in-out property <int> checkpoint_index: 0;
    in-out property <int> target_view_index: 0;
    in-out property <int> ai_mode_index: 0;   // 0 = GPU, 1 = CPU only, 2 = AI off
    in-out property <[string]> angle_labels: [];
    in-out property <int> angle_index: 0;      // index into profiles::CAMERA_ANGLES
    in-out property <[string]> pose_labels: [];
    in-out property <int> pose_index: 0;       // index into profiles::POSES
    in-out property <[string]> bust_labels: [];
    in-out property <int> bust_index: 0; // index into profiles::BUSTS
    in-out property <[string]> frame_labels: [];
    in-out property <int> frame_index: 0; // index into profiles::FRAMES
    in-out property <bool> dynamic_enabled: false;
    in-out property <bool> fit_suggestions: true;
    in-out property <bool> exaggerated_proportions: false;
    in-out property <bool> arranged_enabled: false;   // After as grouped lines
    in-out property <bool> ref_adapter_mode: false;   // Anima Ref Adapter: After keeps only the scene (the adapter copies the look)
    in-out property <bool> natural_enabled: false;    // natural-language sentences (NL checkpoints only)
    in-out property <int> detail_index: 1;     // 0 Faithful, 1 Balanced, 2 Rich (profiles::DetailLevel)
    in-out property <string> dynamic_note: "";
    /// After shows a rolled preview of the Dynamic prompt (render() clears it).
    in-out property <bool> after_rolled: false;
    callback roll_requested();
    in-out property <[string]> model_labels: [];
    in-out property <int> model_index: 0;
    in-out property <bool> model_needs_download: false;

    // Image -> prompt
    in-out property <bool> image_loaded: false;
    in-out property <image> image_thumb;
    in-out property <string> image_status: "Extract Danbooru tags from any image (WD EVA02)";
    in-out property <bool> tagger_installed: false;
    in-out property <bool> tagger_busy: false;   // busy reading an image (tagger or AI)
    in-out property <bool> image_use_ai: false;  // Tagger (false) / AI (true) switch
    in-out property <float> tag_threshold: 0.35;
    in-out property <bool> image_can_undo: false;

    // Scene & Pose Reference Image (Pose + Environment ONLY, never copies character identity; expands preview when loaded)
    in-out property <bool> scene_ref_loaded: false;
    in-out property <image> scene_ref_thumb;
    in-out property <string> scene_ref_status: "";
    callback load_scene_ref_requested();
    // "Reference use": 0 = Scene & pose (classic), 1 = Identity transfer, 2 = Outfit transfer, 3 = Atmosphere
    in-out property <int> reference_use_index: 0;
    callback transfer_requested();
    callback remove_scene_ref_requested();

    // Scene Inspector dropdown panel & character actions
    in-out property <bool> scene_panel_open: false;
    in-out property <bool> scene_adv_open: false;
    in-out property <[ScenePanelChar]> scene_panel_chars: [];
    in-out property <string> scene_override_setting: "";
    in-out property <string> scene_override_exclude: "";
    in-out property <string> scene_override_c1: "";
    in-out property <string> scene_override_c2: "";
    in-out property <string> scene_override_c3: "";
    in-out property <string> scene_override_c4: "";
    // Character reference image thumbnails
    in-out property <bool> char1_image_loaded: false;
    in-out property <image> char1_image_thumb;
    in-out property <bool> char2_image_loaded: false;
    in-out property <image> char2_image_thumb;
    in-out property <bool> char3_image_loaded: false;
    in-out property <image> char3_image_thumb;
    in-out property <bool> char4_image_loaded: false;
    in-out property <image> char4_image_thumb;

    callback auto_scene_requested();
    in-out property <[string]> scene_pose_labels: [];
    callback scene_pose_selected(int, string);
    in-out property <[string]> scene_view_labels: [];
    in-out property <[string]> scene_angle_labels: [];
    callback scene_view_selected(int, string);
    callback scene_angle_selected(int, string);
    callback scene_action_add_requested(int); // 0..3 = character 1..4
    callback scene_char_clear_requested(int); // 0..3 = character 1..4
    callback scene_char_text_edited(int, string); // 0..3 = character 1..4, new edited text
    callback scene_action_move_requested(int, int); // from, to
    callback scene_overrides_changed();
    callback remove_char_image_requested(int); // 0..3 = character 1..4
    callback clear_char_requested(int); // 0..3 = character 1..4

    // Ollama (local or another PC)
    in-out property <string> ollama_host: "localhost:11434";
    /// LoRA folder for trigger-word suggestions (saved in settings).
    in-out property <string> lora_folder: "";
    in-out property <[string]> lora_suggest_c1: [];
    in-out property <[string]> lora_suggest_c2: [];
    in-out property <[string]> lora_suggest_c3: [];
    in-out property <[string]> lora_suggest_c4: [];
    in-out property <[LoraWeight]> lora_weights_c1: [];
    in-out property <[LoraWeight]> lora_weights_c2: [];
    in-out property <[LoraWeight]> lora_weights_c3: [];
    in-out property <[LoraWeight]> lora_weights_c4: [];
    /// A LoRA weight chip's − / + (character 0-3, LoRA index in its box, delta).
    callback lora_weight_step(int, int, float);
    callback pick_lora_folder_requested();
    /// ComfyUI folder (saved; empty = $COMFYUI_PATH, else ~/ComfyUI). The LoRA folder defaults to its models/loras.
    in-out property <string> comfyui_folder: "";
    callback pick_comfyui_folder_requested();
    callback install_comfyui_node_requested();   // writes the ComfyUI add-on into <ComfyUI>/custom_nodes
    in-out property <bool> ollama_connected: false;
    in-out property <bool> ollama_busy: false;
    in-out property <string> ollama_status: "Connecting to Ollama...";

    // Feature toggles
    in-out property <bool> cleanup_enabled: true;
    in-out property <bool> resolve_conflicts_enabled: true;
    in-out property <bool> clamp_weights_enabled: true;

    // Prompt & emphasis
    in-out property <string> raw_prompt: "";
    in-out property <string> pinned_emphasis: "";
    in-out property <string> lora_tags: "";      // Character 1 LoRA tags
    // Multi-character tabs (0..3 = 1..4 Characters)
    in-out property <int> app_tab: 0;
    in-out property <string> char2_prompt: "";
    in-out property <string> char3_prompt: "";
    in-out property <string> char4_prompt: "";
    in-out property <string> char2_lora_tags: "";
    in-out property <string> char3_lora_tags: "";
    in-out property <string> char4_lora_tags: "";
    in-out property <string> char2_stats: "";
    in-out property <string> char3_stats: "";
    in-out property <string> char4_stats: "";
    in-out property <string> scene_prompt: "";       // SHARED PROMPT (shared by all characters)
    in-out property <bool> char_break_enabled: true;
    // BREAK means something to CLIP checkpoints only: Pony (1), Illustrious (2), SDXL (3), SD 1.5 (4)
    property <bool> break_supported: root.checkpoint_index >= 1 && root.checkpoint_index <= 4;
    in-out property <float> emphasis_weight: 1.25;
    in-out property <string> condensed_prompt: "";       // plain text, used for copy
    in-out property <string> substituted_list: "";   // tags put in place of yours
    in-out property <string> added_list: "";         // tags that weren't in your prompt

    // Deep scan results
    in-out property <bool> ai_improved_available: false;
    in-out property <int> after_view: 0;   // 0 = rule-based, 1 = AI improved
    in-out property <string> scene_summary: "";
    in-out property <string> scene_details: "";
    in-out property <string> scene_issues: "";
    in-out property <string> ai_dropped: "";   // user tags the AI rewrite left out

    // Layout (saved between sessions)
    in-out property <float> before_ratio: 0.56;
    in-out property <length> side_width: 420px;
    in-out property <length> cards_strip_height: 155px;
    /// The workspace's scroll position, and how far it can scroll (0 when it fits); the smoke test scrolls it.
    in-out property <length> workspace_scroll_y: 0px;
    out property <length> workspace_overflow: max(0px, workspace-scroll.content-height - workspace-scroll.visible-height);
    in-out property <bool> output_collapsed: false;

    // Live scene description (rule-based)
    in-out property <string> live_headline: "";
    in-out property <string> live_details: "";
    in-out property <string> live_missing: "";
    in-out property <float> ui_zoom: 0.75;
    in-out property <int> ui_zoom_percent: 100;

    // Recommended negative prompt
    in-out property <string> negative_text: "";
    in-out property <string> negative_note: "";
    in-out property <string> category_breakdown: "";
    in-out property <[StructureRow]> structure_rows;

    // Stats & status
    in-out property <string> before_stats: "";
    in-out property <string> after_stats: "";
    in-out property <bool> before_stats_warn;
    in-out property <bool> after_stats_warn;
    in-out property <bool> char2_stats_warn;
    in-out property <bool> char3_stats_warn;
    in-out property <bool> char4_stats_warn;
    in-out property <string> hardware_badge: "Detecting GPU / VRAM...";
    in-out property <string> status_message: "Ready — paste a ComfyUI prompt.";
    in-out property <bool> ai_busy: false;
    in-out property <string> run_badge: "";
    /// ComfyUI answers at 127.0.0.1:8188 (`live_bridge::start_probe`).
    in-out property <bool> comfyui_online: false;
    /// "⚡ Queue" (status bar, enabled while ComfyUI answers): writes live_prompt.json now and asks the
    /// add-on to press Queue in the open ComfyUI tab (`live_bridge::wire_queue`).
    callback queue_comfyui_requested();

    in-out property <[ChangeCardItem]> change_cards: [];
    in-out property <int> card_filter: 0;              // card strip filter (not saved)
    in-out property <[int]> card_filter_counts: [0, 0, 0, 0, 0];
    in-out property <bool> ideas_busy: false;          // 💡 Ideas: E4B is suggesting tags for the gaps
    callback card_chip_toggled(int, string);
    callback card_expand_fixes();
    callback card_filter_changed(int);
    callback ideas_requested();

    callback analyze_requested();
    callback ai_settings_changed();
    callback run_ai_scan_requested();
    callback cancel_requested();   // stop a Deep Scan / image read after its current step
    callback copy_vrp_requested(); // LuCiD VRP regions (one per character) to the clipboard
    callback download_model_requested();
    callback connect_ollama_requested();
    callback load_image_requested();
    callback remove_image_requested();
    callback image_mode_changed();
    in-out property <bool> enable_dual_pass: false;      // always off: Dual-Pass Vision was never better than the default (option removed 2026-11-12)
    in-out property <bool> image_advanced: false;        // show the older image-reading options (dual pass, synthesis, 2nd pass check)
    callback dual_pass_changed();
    in-out property <int> dual_pass_mode_index: 0;      // 0: Scene + Body Shape (Mode A), 1: Scene + Skeletal Pose (Mode B)
    in-out property <[string]> dual_pass_mode_labels: ["Scene + Body Shape (Mode A)", "Scene + Skeletal Pose (Mode B)"];
    callback dual_pass_mode_changed();
    in-out property <bool> use_llm_synthesis: true;     // LLM Tag Synthesis (Gemma 4 12B)
    callback llm_synthesis_changed();
    in-out property <string> pipeline_warnings: "";     // Pipeline fallback warnings (e.g. Ollama unreachable)
    in-out property <bool> image_identity_only: false;   // images supply only who + outfit
    callback identity_changed();
    in-out property <bool> image_second_pass: false;    // always off: image reads write with E4B, which can't see (option removed 2026-11-12)
    callback second_pass_changed();
    in-out property <bool> scene_body_shape: false;     // swap body shape from scene reference, keep outfit/height/face
    callback scene_body_shape_changed();
    callback read_image_requested();
    callback redo_image_requested();
    in-out property <bool> images_pending: false;   // reference images picked, not read yet

    /// prompt vs LoRA split inside each character's card (saved in settings)
    in-out property <float> lora_split_ratio_c1: 0.7;
    in-out property <float> lora_split_ratio_c2: 0.7;
    in-out property <float> lora_split_ratio_c3: 0.7;
    in-out property <float> lora_split_ratio_c4: 0.7;
    callback char_image_requested(int);                  // 0..3 = character 1..4
    // Danbooru translator dialog
    in-out property <bool> translate_open: false;
    // Region editor (2-4 Characters tabs): one box per character over the picture, dragged / resized here
    in-out property <bool> vrp_open: false;
    in-out property <[VrpRegion]> vrp_regions: [];
    in-out property <float> vrp_aspect: 1.46;   // canvas width / height
    in-out property <bool> vrp_has_image: false;
    callback edit_vrp_requested();
    callback vrp_region_moved(int, float, float);    // region, dx, dy (fractions of the canvas)
    callback vrp_region_resized(int, float, float);  // region, dw, dh
    callback vrp_reset_requested();
    in-out property <bool> translate_busy: false;
    in-out property <string> translate_input: "";
    in-out property <string> translate_tags: "";
    in-out property <string> translate_natural: "";
    in-out property <string> translate_notes: "";
    in-out property <string> translate_status: "";
    in-out property <bool> translate_use_natural: true;
    // natural language: Anima (0), SDXL (3), Flux (5) — profiles::supports_natural_language
    property <bool> translate_nl: root.checkpoint_index == 0 || root.checkpoint_index == 3 || root.checkpoint_index == 5;
    callback translate_requested();
    callback translate_apply_requested(bool);   // true = replace the Before prompt
    callback undo_image_prompt_requested();
    callback png_prompt_requested(); // the generation prompt saved in a PNG into Before (png_meta)
    callback check_result_requested(); // tag a generated picture and compare it with Before (check.rs)
    callback download_tagger_requested();
    callback tag_threshold_changed();
    callback copy_output_requested();
    callback copy_section_blocks_requested();
    callback card_mode_changed(int, int); // (card_id, new_mode)
    callback after_view_changed(int);
    callback copy_recommended_negative_requested();
    callback add_quality_requested();   // "+ Quality": the checkpoint's quality tags in front of Before
    callback zoom_in_requested();
    callback zoom_out_requested();

    VerticalLayout {
        padding: 10px;
        spacing: 6px;

        // ==================== ROW 1: UNIFIED TOP APP BAR ====================
        M3Card {
          VerticalLayout {
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                padding-top: 6px;
                padding-bottom: 6px;
                spacing: 8px;

                // The active characters (app_tab + 1), "✕" on the last one and "+ Add character" (max 4).
                // ✕ only lowers the count: the box keeps its text (saved) and comes back on + Add.
                for idx in root.app_tab + 1 : PillButton {
                    text: root.app_tab == 0 ? "👤 1 Character" : "👤 " + (idx + 1);
                    primary: true;
                }
                if root.app_tab > 0 : PillButton {
                    text: "✕";
                    clicked => { root.app_tab = root.app_tab - 1; root.analyze_requested(); }
                }
                if root.app_tab < 3 : PillButton {
                    text: root.narrow ? "+ Add" : "+ Add character";
                    clicked => { root.app_tab = root.app_tab + 1; root.analyze_requested(); }
                }

                if root.app_tab >= 1 : PillButton {
                    text: root.narrow ? "🗺 VRP" : "🗺 Copy VRP regions";
                    clicked => { root.copy_vrp_requested(); root.show-copied(); }
                }
                if root.app_tab >= 1 : PillButton {
                    text: root.narrow ? "✎" : "✎ Edit regions";
                    clicked => { root.edit_vrp_requested(); }
                }
                PillButton {
                    text: root.narrow ? "🕒 " + root.history_count : "🕒 History (" + root.history_count + ")";
                    primary: root.history_open;
                    clicked => { root.history_open_requested(); }
                }
                PillButton {
                    text: "🎨";
                    primary: root.palette_open;
                    clicked => { root.palette_open = !root.palette_open; }
                }
                PillButton {
                    text: root.zen_mode ? "⛶ Exit Zen" : "⛶ Zen";
                    primary: root.zen_mode;
                    clicked => { root.zen_mode = !root.zen_mode; }
                }
                PillButton {
                    text: root.narrow ? "📖 Words" : "📖 Danbooru";
                    clicked => { root.translate_status = ""; root.translate_open = true; }
                }
                PillButton {
                    text: root.ai_busy ? "Working…" : (root.narrow ? "✦ Deep Scan" : "✦ Run Deep AI Scan");
                    primary: true;
                    enabled: !root.ai_busy && root.ai_mode_index != 2 && root.ollama_connected && !root.model_needs_download;
                    clicked => { root.run_ai_scan_requested(); }
                }
                if root.ai_busy || root.tagger_busy : PillButton {
                    text: "✕ Cancel";
                    clicked => { root.cancel_requested(); }
                }
                if root.model_needs_download && root.ai_mode_index != 2 : PillButton {
                    text: "Download Model";
                    enabled: !root.ai_busy && root.ollama_connected;
                    clicked => { root.download_model_requested(); }
                }

                Rectangle { horizontal-stretch: 1; }

                if !root.narrow : HostThemeControls {
                    host <=> root.ollama_host;
                    connected: root.ollama_connected;
                    busy: root.ollama_busy;
                    connect => { root.connect_ollama_requested(); }
                    theme-changed => { root.theme_changed(); }
                }
            }
            // narrow window: THEME and the Ollama host on their own row
            if root.narrow : HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                padding-bottom: 6px;
                alignment: end;
                HostThemeControls {
                    host <=> root.ollama_host;
                    connected: root.ollama_connected;
                    busy: root.ollama_busy;
                    connect => { root.connect_ollama_requested(); }
                    theme-changed => { root.theme_changed(); }
                }
            }
          }
        }

        // ==================== ROWS 2-4: OPTIONS + WORKSPACE (scroll when the window is too short) ====================
        // They scroll as one when the window is shorter than they need (800×600 with the Options open), so the
        // top bar above and the status bar below always stay in view; with room to spare they fill the height.
        workspace-scroll := ScrollView {
            vertical-stretch: 1;
            content-y <=> root.workspace_scroll_y;
            content-height: workspace-area.height;
            workspace-area := Rectangle {
                // a sized element is centered unless placed: keep it at the top of the viewport
                x: 0;
                y: 0;
                width: workspace-scroll.visible-width;
                height: max(workspace-scroll.visible-height, middle.min-height);
                middle := VerticalLayout {
                    spacing: 6px;
                    // ==================== ROW 2: TWO-BAR CHECKPOINT AREA + COLLAPSIBLE OPTIONS + BOOST & SHARED PROMPT ====================
                    M3Card {
                        VerticalLayout {
                            padding: 8px;
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 6px;

                            // ---- BAR 1: Model | AI | Detail | LLM + Always-Visible IMAGE Controls (Outside Options!)
                            HorizontalLayout {
                                spacing: 8px;

                                SectionLabel { text: "Model:"; vertical-alignment: center; }
                                ComboBox {
                                    horizontal-stretch: 1;
                                    min-width: 90px;
                                    model: [
                                        "Anima (Hybrid + NL)",
                                        "Pony Diffusion V6 XL",
                                        "Illustrious / NoobAI XL",
                                        "SDXL (Base / Finetunes)",
                                        "SD 1.5",
                                        "Flux (Natural Language)"
                                    ];
                                    current-index <=> root.checkpoint_index;
                                    selected => { root.analyze_requested(); }
                                }

                                SectionLabel { text: "AI:"; vertical-alignment: center; }
                                ComboBox {
                                    horizontal-stretch: 1;
                                    min-width: 90px;
                                    model: [
                                        "GPU (Vulkan)",
                                        "CPU Only",
                                        "AI Off (Rules)"
                                    ];
                                    current-index <=> root.ai_mode_index;
                                    selected => { root.ai_settings_changed(); }
                                }

                                ComboBox {
                                    width: 110px;
                                    model: ["Faithful", "Balanced", "Rich"];
                                    current-index <=> root.detail_index;
                                    selected => { root.ai_settings_changed(); }
                                }

                                SectionLabel { text: "LLM:"; vertical-alignment: center; }
                                ComboBox {
                                    horizontal-stretch: 1;
                                    min-width: 145px;
                                    model: root.model_labels;
                                    current-index <=> root.model_index;
                                    enabled: root.ai_mode_index != 2;
                                    selected => { root.ai_settings_changed(); }
                                }

                            }

                            // ---- BAR 2: View | Angle | Pose + Collapsible Options Toggle Button (hidden in Zen mode)
                            if !root.zen_mode : HorizontalLayout {
                                spacing: 8px;

                                // first, so it stays reachable in a narrow window
                                PillButton {
                                    text: root.options_expanded ? "▾ Options"
                                        : root.options_changed > 0 ? "▸ Options · " + root.options_changed : "▸ Options";
                                    primary: root.options_expanded;
                                    clicked => { root.options_expanded = !root.options_expanded; }
                                }

                                SectionLabel { text: "View:"; vertical-alignment: center; }
                                ComboBox {
                                    horizontal-stretch: 1;
                                    min-width: 60px;
                                    model: [
                                        "None (Auto-Detect Framing)",
                                        "360 View / Turnaround",
                                        "Upper Body / Cowboy Shot",
                                        "Close-Up / Portrait",
                                        "Front View",
                                        "From Behind / Back View",
                                        "Side Profile",
                                        "Full Body"
                                    ];
                                    current-index <=> root.target_view_index;
                                    selected => { root.analyze_requested(); }
                                }

                                SectionLabel { text: "Angle:"; vertical-alignment: center; }
                                ComboBox {
                                    horizontal-stretch: 1;
                                    min-width: 60px;
                                    model: root.angle_labels;
                                    current-index <=> root.angle_index;
                                    selected => { root.analyze_requested(); }
                                }

                                SectionLabel { text: "Pose:"; vertical-alignment: center; }
                                ComboBox {
                                    horizontal-stretch: 1;
                                    min-width: 60px;
                                    model: root.pose_labels;
                                    current-index <=> root.pose_index;
                                    selected => { root.analyze_requested(); }
                                }

                                SectionLabel { text: "Bust:"; vertical-alignment: center; }
                                ComboBox {
                                    horizontal-stretch: 1;
                                    min-width: 60px;
                                    model: root.bust_labels;
                                    current-index <=> root.bust_index;
                                    selected => { root.analyze_requested(); }
                                }

                                SectionLabel { text: "Frame:"; vertical-alignment: center; }
                                ComboBox {
                                    horizontal-stretch: 1;
                                    min-width: 60px;
                                    model: root.frame_labels;
                                    current-index <=> root.frame_index;
                                    selected => { root.analyze_requested(); }
                                }

                            }

                            // ---- COLLAPSIBLE OPTIONS DRAWER (the Option chips, then the folders row)
                            if root.options_expanded && !root.zen_mode : HorizontalLayout {
                                spacing: 6px;
                                alignment: start;
                                SectionLabel { text: "OPTIONS:"; vertical-alignment: center; }
                                FilterChip {
                                    text: "Clean Bloat";
                                    checked <=> root.cleanup_enabled;
                                    toggled => { root.analyze_requested(); }
                                }
                                FilterChip {
                                    text: "Fix Conflicts";
                                    checked <=> root.resolve_conflicts_enabled;
                                    toggled => { root.analyze_requested(); }
                                }
                                FilterChip {
                                    text: "Clamp Weights";
                                    checked <=> root.clamp_weights_enabled;
                                    toggled => { root.analyze_requested(); }
                                }
                                FilterChip {
                                    text: "Arranged";
                                    checked <=> root.arranged_enabled;
                                    toggled => { root.analyze_requested(); }
                                }
                                if !root.narrow : MoreOptionChips {
                                    fit-suggestions <=> root.fit_suggestions;
                                    exaggerated-proportions <=> root.exaggerated_proportions;
                                    ref-adapter <=> root.ref_adapter_mode;
                                    natural-available: root.translate_nl;
                                    natural <=> root.natural_enabled;
                                    dynamic <=> root.dynamic_enabled;
                                    show-break: root.app_tab >= 1;
                                    break-supported: root.break_supported;
                                    char-break <=> root.char_break_enabled;
                                    toggled => { root.analyze_requested(); }
                                }
                            }
                            // narrow window: the rest of the chips on their own row
                            if root.options_expanded && !root.zen_mode && root.narrow : HorizontalLayout {
                                spacing: 6px;
                                alignment: start;
                                MoreOptionChips {
                                    fit-suggestions <=> root.fit_suggestions;
                                    exaggerated-proportions <=> root.exaggerated_proportions;
                                    ref-adapter <=> root.ref_adapter_mode;
                                    natural-available: root.translate_nl;
                                    natural <=> root.natural_enabled;
                                    dynamic <=> root.dynamic_enabled;
                                    show-break: root.app_tab >= 1;
                                    break-supported: root.break_supported;
                                    char-break <=> root.char_break_enabled;
                                    toggled => { root.analyze_requested(); }
                                }
                            }
                            if root.options_expanded && !root.zen_mode : HorizontalLayout {
                                spacing: 6px;
                                alignment: start;
                                SectionLabel { text: "FOLDERS:"; vertical-alignment: center; }
                                SectionLabel { text: "ComfyUI:"; vertical-alignment: center; }
                                LineEdit {
                                    width: 180px;
                                    height: 30px;
                                    font-size: 12px;
                                    placeholder-text: "$COMFYUI_PATH or ~/ComfyUI";
                                    text <=> root.comfyui_folder;
                                    edited => { root.analyze_requested(); }
                                }
                                PillButton {
                                    text: "📁";
                                    clicked => { root.pick_comfyui_folder_requested(); }
                                }
                                PillButton {
                                    text: "⚡ Install Node";
                                    clicked => { root.install_comfyui_node_requested(); }
                                }
                                SectionLabel { text: "LoRA folder:"; vertical-alignment: center; }
                                LineEdit {
                                    width: 180px;
                                    height: 30px;
                                    font-size: 12px;
                                    placeholder-text: "default: ComfyUI/models/loras";
                                    text <=> root.lora_folder;
                                    edited => { root.analyze_requested(); }
                                }
                                PillButton {
                                    text: "📁";
                                    clicked => { root.pick_lora_folder_requested(); }
                                }
                            }

                            // ---- BOOST | SHARED PROMPT, side by side (each shrinks with the window; Slint can't wrap).
                            // The Shared Prompt counts on every tab (`with_scene`), so it is always shown.
                            HorizontalLayout {
                                spacing: 14px;
                                HorizontalLayout {
                                    horizontal-stretch: 1;
                                    min-width: 220px;
                                    spacing: 6px;
                                    SectionLabel {
                                        width: 92px;
                                        text: "BOOST " + Math.round(root.emphasis_weight * 100) / 100 + "x:";
                                        color: M3.success;
                                        vertical-alignment: center;
                                    }
                                    LineEdit {
                                        horizontal-stretch: 1;
                                        min-width: 60px;
                                        font-size: 12px;
                                        height: 30px;
                                        placeholder-text: "Tags to emphasize, e.g. glasses, thick eyebrows";
                                        text <=> root.pinned_emphasis;
                                        edited => { root.analyze_requested(); }
                                    }
                                    Slider {
                                        width: 80px;
                                        minimum: 1.0;
                                        maximum: 1.5;
                                        value <=> root.emphasis_weight;
                                        changed => { root.analyze_requested(); }
                                    }
                                }
                                HorizontalLayout {
                                    horizontal-stretch: 1;
                                    min-width: 220px;
                                    spacing: 6px;
                                    SectionLabel {
                                        width: 108px;
                                        text: "SHARED PROMPT:";
                                        color: M3.info;
                                        vertical-alignment: center;
                                    }
                                    LineEdit {
                                        horizontal-stretch: 1;
                                        min-width: 60px;
                                        font-size: 12px;
                                        height: 30px;
                                        placeholder-text: "Setting, camera, lighting & actions for everyone, e.g. tavern table, warm lighting";
                                        text <=> root.scene_prompt;
                                        edited => { root.analyze_requested(); }
                                    }
                                }
                            }

                            // ---- SCENE & REFERENCE BAR + LOWERABLE DROPDOWN PANEL (Unified Reference Section)
                            VerticalLayout {
                                spacing: 6px;
                                padding-top: 2px;

                                // 1. Sleek bar with visible previews (clickable to load or remove)
                                Rectangle {
                                    background: M3.surface-container;
                                    border-radius: 10px;
                                    border-width: 1px;
                                    border-color: (root.scene_ref_loaded || root.image_loaded || root.char1_image_loaded) ? M3.info-container : M3.outline-variant;
                                  VerticalLayout {
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 10px;
                                        padding-top: 5px;
                                        padding-bottom: 5px;
                                        spacing: 8px;
                                        alignment: center;

                                        // Scene Reference Thumbnail (or "+ Scene" slot if not loaded)
                                        Rectangle {
                                            width: 56px;
                                            height: 34px;
                                            border-radius: 6px;
                                            border-width: 1.5px;
                                            border-color: root.scene_ref_loaded ? M3.primary : M3.outline;
                                            clip: true;
                                            background: M3.surface-container-high;
                                            if root.scene_ref_loaded : Image {
                                                source: root.scene_ref_thumb;
                                                width: parent.width;
                                                height: parent.height;
                                                image-fit: cover;
                                            }
                                            if !root.scene_ref_loaded : Text {
                                                text: "+ Scene";
                                                font-size: 10px;
                                                font-weight: 600;
                                                color: M3.on-surface-variant;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                            if root.scene_ref_loaded && scene-thumb-ta.has-hover : Rectangle {
                                                background: #000000b8;
                                                Text {
                                                    text: "✕";
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                    font-size: 12px;
                                                    font-weight: 700;
                                                    color: M3.error;
                                                }
                                            }
                                            scene-thumb-ta := TouchArea {
                                                mouse-cursor: MouseCursor.pointer;
                                                clicked => {
                                                    if root.scene_ref_loaded {
                                                        root.remove_scene_ref_requested();
                                                    } else {
                                                        root.load_scene_ref_requested();
                                                    }
                                                }
                                            }
                                        }

                                        // Optional Split Image slot (full multi-person image)
                                        if root.image_loaded : Rectangle {
                                            width: 44px;
                                            height: 34px;
                                            border-radius: 6px;
                                            clip: true;
                                            background: M3.surface-container-high;
                                            Image {
                                                source: root.image_thumb;
                                                width: parent.width;
                                                height: parent.height;
                                                image-fit: cover;
                                            }
                                            if split-ta.has-hover : Rectangle {
                                                background: #000000b0;
                                                Text { text: "✕"; font-size: 11px; font-weight: 700; color: #ffffff; }
                                            }
                                            split-ta := TouchArea {
                                                mouse-cursor: MouseCursor.pointer;
                                                clicked => { root.remove_image_requested(); }
                                            }
                                        }

                                        // Character 1..4 image preview slots with hover ✕ to remove
                                        if root.char1_image_loaded : Rectangle {
                                            width: 28px;
                                            height: 34px;
                                            border-radius: 4px;
                                            border-width: 1px;
                                            border-color: M3.warning;
                                            clip: true;
                                            background: M3.surface-container-high;
                                            Image { source: root.char1_image_thumb; width: parent.width; height: parent.height; image-fit: cover; }
                                            if c1-ta.has-hover : Rectangle {
                                                background: #000000b0;
                                                Text { text: "✕"; font-size: 10px; font-weight: 700; color: M3.error; }
                                            }
                                            c1-ta := TouchArea {
                                                mouse-cursor: MouseCursor.pointer;
                                                clicked => { root.remove_char_image_requested(0); }
                                            }
                                        }
                                        if !root.char1_image_loaded : PillButton {
                                            text: "+ C1";
                                            clicked => { root.char_image_requested(0); }
                                        }

                                        if root.app_tab >= 1 && root.char2_image_loaded : Rectangle {
                                            width: 28px;
                                            height: 34px;
                                            border-radius: 4px;
                                            border-width: 1px;
                                            border-color: M3.info;
                                            clip: true;
                                            background: M3.surface-container-high;
                                            Image { source: root.char2_image_thumb; width: parent.width; height: parent.height; image-fit: cover; }
                                            if c2-ta.has-hover : Rectangle {
                                                background: #000000b0;
                                                Text { text: "✕"; font-size: 10px; font-weight: 700; color: M3.error; }
                                            }
                                            c2-ta := TouchArea {
                                                mouse-cursor: MouseCursor.pointer;
                                                clicked => { root.remove_char_image_requested(1); }
                                            }
                                        }
                                        if root.app_tab >= 1 && !root.char2_image_loaded : PillButton {
                                            text: "+ C2";
                                            clicked => { root.char_image_requested(1); }
                                        }

                                        if root.app_tab >= 2 && root.char3_image_loaded : Rectangle {
                                            width: 28px;
                                            height: 34px;
                                            border-radius: 4px;
                                            border-width: 1px;
                                            border-color: M3.success;
                                            clip: true;
                                            background: M3.surface-container-high;
                                            Image { source: root.char3_image_thumb; width: parent.width; height: parent.height; image-fit: cover; }
                                            if c3-ta.has-hover : Rectangle {
                                                background: #000000b0;
                                                Text { text: "✕"; font-size: 10px; font-weight: 700; color: M3.error; }
                                            }
                                            c3-ta := TouchArea {
                                                mouse-cursor: MouseCursor.pointer;
                                                clicked => { root.remove_char_image_requested(2); }
                                            }
                                        }
                                        if root.app_tab >= 2 && !root.char3_image_loaded : PillButton {
                                            text: "+ C3";
                                            clicked => { root.char_image_requested(2); }
                                        }

                                        if root.app_tab >= 3 && root.char4_image_loaded : Rectangle {
                                            width: 28px;
                                            height: 34px;
                                            border-radius: 4px;
                                            border-width: 1px;
                                            border-color: M3.tertiary;
                                            clip: true;
                                            background: M3.surface-container-high;
                                            Image { source: root.char4_image_thumb; width: parent.width; height: parent.height; image-fit: cover; }
                                            if c4-ta.has-hover : Rectangle {
                                                background: #000000b0;
                                                Text { text: "✕"; font-size: 10px; font-weight: 700; color: M3.error; }
                                            }
                                            c4-ta := TouchArea {
                                                mouse-cursor: MouseCursor.pointer;
                                                clicked => { root.remove_char_image_requested(3); }
                                            }
                                        }
                                        if root.app_tab >= 3 && !root.char4_image_loaded : PillButton {
                                            text: "+ C4";
                                            clicked => { root.char_image_requested(3); }
                                        }

                                        // Zone 1 (cont.): load button + status
                                        if !root.image_loaded : PillButton {
                                            text: root.app_tab >= 1 ? "🖼 Split Image…" : "🖼 From Image…";
                                            clicked => { root.load_image_requested(); }
                                        }
                                        if root.app_tab == 0 : PillButton {
                                            text: "📄 From PNG…";
                                            clicked => { root.png_prompt_requested(); }
                                        }
                                        if root.app_tab == 0 : PillButton {
                                            text: "🔍 Check Result…";
                                            clicked => { root.check_result_requested(); }
                                        }
                                        if root.image_can_undo : PillButton {
                                            text: "↶ Undo";
                                            clicked => { root.undo_image_prompt_requested(); }
                                        }
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 1px;
                                            alignment: center;
                                            Text {
                                                text: root.scene_ref_loaded ? "🌄 SCENE REFERENCE LOADED" : "🌄 REFERENCES & SCENE";
                                                overflow: elide;
                                                font-size: 11px;
                                                font-weight: 700;
                                                color: (root.scene_ref_loaded || root.image_loaded) ? M3.primary : M3.on-surface;
                                            }
                                            Text {
                                                text: root.scene_ref_loaded
                                                    ? (root.scene_ref_status != "" ? root.scene_ref_status : "Reference ready: pick what it's used for, then press the main button.")
                                                    : (root.image_status != "" ? root.image_status : "Load a picture or a scene reference.");
                                                font-size: 10px;
                                                color: M3.on-surface-variant;
                                                overflow: elide;
                                            }
                                        }

                                        if !root.narrow : ScanZone {
                                            image-use-ai <=> root.image_use_ai;
                                            tagger-busy: root.tagger_busy;
                                            scene-ref-loaded: root.scene_ref_loaded;
                                            app-tab: root.app_tab;
                                            reference-use-index <=> root.reference_use_index;
                                            image-loaded: root.image_loaded;
                                            images-pending: root.images_pending;
                                            char1-image-loaded: root.char1_image_loaded;
                                            image-advanced <=> root.image_advanced;
                                            scene-panel-open <=> root.scene_panel_open;
                                            settings-on: (root.image_identity_only ? 1 : 0) + (root.scene_body_shape ? 1 : 0);
                                            image-mode-changed => { root.image_mode_changed(); }
                                            transfer => { root.transfer_requested(); }
                                            auto-scene => { root.auto_scene_requested(); }
                                            read-image => { root.read_image_requested(); }
                                        }
                                    }
                                    // narrow window: the scan engine, main action and drawers on their own row
                                    if root.narrow : HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 10px;
                                        padding-bottom: 5px;
                                        alignment: end;
                                        ScanZone {
                                            image-use-ai <=> root.image_use_ai;
                                            tagger-busy: root.tagger_busy;
                                            scene-ref-loaded: root.scene_ref_loaded;
                                            app-tab: root.app_tab;
                                            reference-use-index <=> root.reference_use_index;
                                            image-loaded: root.image_loaded;
                                            images-pending: root.images_pending;
                                            char1-image-loaded: root.char1_image_loaded;
                                            image-advanced <=> root.image_advanced;
                                            scene-panel-open <=> root.scene_panel_open;
                                            settings-on: (root.image_identity_only ? 1 : 0) + (root.scene_body_shape ? 1 : 0);
                                            image-mode-changed => { root.image_mode_changed(); }
                                            transfer => { root.transfer_requested(); }
                                            auto-scene => { root.auto_scene_requested(); }
                                            read-image => { root.read_image_requested(); }
                                        }
                                    }
                                  }
                                }

                                // Vision settings drawer ("⚙ Settings")
                                if root.image_advanced : Rectangle {
                                    background: M3.surface-container;
                                    border-radius: 10px;
                                    border-width: 1px;
                                    border-color: M3.outline-variant;
                                    VerticalLayout {
                                        padding: 10px;
                                        spacing: 8px;
                                        HorizontalLayout {
                                            spacing: 10px;
                                            SectionLabel { text: "SENSITIVITY (THRESHOLD):"; vertical-alignment: center; }
                                            Slider {
                                                horizontal-stretch: 1;
                                                minimum: 0.15;
                                                maximum: 0.60;
                                                value <=> root.tag_threshold;
                                                released => { root.tag_threshold_changed(); }
                                            }
                                            Text {
                                                text: Math.round(root.tag_threshold * 100) / 100;
                                                font-size: 12px;
                                                color: M3.on-surface;
                                                vertical-alignment: center;
                                                min-width: 32px;
                                            }
                                            Text {
                                                text: "lower = more tags";
                                                font-size: 10px;
                                                color: M3.on-surface-variant;
                                                vertical-alignment: center;
                                            }
                                        }
                                        HorizontalLayout {
                                            spacing: 8px;
                                            alignment: start;
                                            SectionLabel { text: "FILTERS:"; vertical-alignment: center; }
                                            FilterChip {
                                                text: "Identity Only";
                                                checked <=> root.image_identity_only;
                                                enabled: !root.tagger_busy;
                                                toggled => { root.identity_changed(); }
                                            }
                                            FilterChip {
                                                text: "Scene Body Shape";
                                                checked <=> root.scene_body_shape;
                                                enabled: !root.tagger_busy;
                                                toggled => { root.scene_body_shape_changed(); }
                                            }
                                            PillButton {
                                                text: "↻ Flush Vision Cache";
                                                enabled: !root.tagger_busy && (root.image_loaded || root.images_pending || root.scene_ref_loaded || root.char1_image_loaded);
                                                clicked => { root.redo_image_requested(); }
                                            }
                                        }
                                    }
                                }

                                // Dual-pass / pipeline warnings notice area
                                if root.pipeline_warnings != "" : Rectangle {
                                    background: #ffb4a924;
                                    border-radius: 6px;
                                    border-width: 1px;
                                    border-color: M3.error;
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 10px;
                                        padding-top: 6px;
                                        padding-bottom: 6px;
                                        spacing: 8px;
                                        alignment: start;
                                        Text {
                                            text: "⚠ Pipeline Notice: " + root.pipeline_warnings;
                                            font-size: 11px;
                                            color: M3.error;
                                            overflow: elide;
                                            vertical-alignment: center;
                                        }
                                        Rectangle { horizontal-stretch: 1; }
                                        TouchArea {
                                            width: 20px;
                                            height: 20px;
                                            mouse-cursor: MouseCursor.pointer;
                                            clicked => { root.pipeline_warnings = ""; }
                                            Text {
                                                text: "✕";
                                                font-size: 12px;
                                                font-weight: 700;
                                                color: M3.error;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }

                                // 2. Lowerable Scene Inspector & Advanced Overrides Panel
                                if root.scene_panel_open : Rectangle {
                                    background: M3.surface-container-high;
                                    border-radius: 12px;
                                    border-width: 1.5px;
                                    border-color: M3.primary;
                                    VerticalLayout {
                                        padding: 10px;
                                        spacing: 8px;

                                        // Scene Setting & Lighting Header row
                                        HorizontalLayout {
                                            spacing: 8px;
                                            alignment: center;
                                            Text {
                                                text: "🌄 SCENE & LIGHTING (Live & Editable):";
                                                font-size: 11px;
                                                font-weight: 700;
                                                color: M3.primary;
                                                vertical-alignment: center;
                                            }
                                            Text {
                                                text: "— Extends across horizontal bar, edits update output prompt";
                                                font-size: 10px;
                                                color: M3.on-surface-variant;
                                                vertical-alignment: center;
                                            }
                                            Rectangle { horizontal-stretch: 1; }
                                            PillButton {
                                                text: root.scene_adv_open ? "⚙ Advanced Settings ▴" : "⚙ Advanced Settings ▾";
                                                primary: root.scene_adv_open;
                                                clicked => { root.scene_adv_open = !root.scene_adv_open; }
                                            }
                                        }

                                        // Full-width bar extending across the horizontal container
                                        Rectangle {
                                            horizontal-stretch: 1;
                                            min-height: 48px;
                                            background: M3.surface-container-low;
                                            border-radius: 6px;
                                            border-width: 1.5px;
                                            border-color: M3.primary;

                                            VerticalLayout {
                                                padding: 6px;
                                                TextEdit {
                                                    horizontal-stretch: 1;
                                                    vertical-stretch: 1;
                                                    font-size: 11px;
                                                    wrap: word-wrap;
                                                    // two-way: a one-way `text:` stops following the property once
                                                    // you type in it, and later Auto Scene results wouldn't show
                                                    text <=> root.scene_override_setting;
                                                    edited => { root.scene_overrides_changed(); }
                                                }
                                            }
                                        }

                                        // Horizontal character cards
                                        HorizontalLayout {
                                            spacing: 8px;
                                            min-height: 80px;
                                            for c[idx] in root.scene_panel_chars : Rectangle {
                                                horizontal-stretch: 1;
                                                background: M3.surface-container;
                                                border-radius: 8px;
                                                border-width: 1px;
                                                border-color: M3.outline-variant;
                                                VerticalLayout {
                                                    padding: 8px;
                                                    spacing: 6px;
                                                    HorizontalLayout {
                                                        spacing: 4px;
                                                        alignment: center;
                                                        Text {
                                                            text: c.title;
                                                            font-size: 11px;
                                                            font-weight: 700;
                                                            color: idx == 0 ? M3.warning : idx == 1 ? M3.info : idx == 2 ? M3.success : M3.tertiary;
                                                            vertical-alignment: center;
                                                        }
                                                        Rectangle { horizontal-stretch: 1; }
                                                        if c.has_actions : PillButton {
                                                            text: "✕ Clear";
                                                            clicked => { root.scene_char_clear_requested(idx); }
                                                        }
                                                    }

                                                    // per-character View | Angle | Pose
                                                    HorizontalLayout {
                                                        spacing: 4px;
                                                        ComboBox {
                                                            horizontal-stretch: 1;
                                                            min-width: 90px;
                                                            model: root.scene_view_labels;
                                                            current-index: c.view_index;
                                                            selected(val) => { root.scene_view_selected(idx, val); }
                                                        }
                                                        ComboBox {
                                                            horizontal-stretch: 1;
                                                            min-width: 90px;
                                                            model: root.scene_angle_labels;
                                                            current-index: c.angle_index;
                                                            selected(val) => { root.scene_angle_selected(idx, val); }
                                                        }
                                                        ComboBox {
                                                            horizontal-stretch: 1;
                                                            min-width: 90px;
                                                            model: root.scene_pose_labels;
                                                            current-index: c.pose_index;
                                                            selected(val) => { root.scene_pose_selected(idx, val); }
                                                        }
                                                    }

                                                    // Character Reference thumbnail preview / upload inside the card
                                                    HorizontalLayout {
                                                        spacing: 6px;
                                                        alignment: start;
                                                        if (idx == 0 && root.char1_image_loaded) : Rectangle {
                                                            width: 28px; height: 36px; border-radius: 4px; clip: true;
                                                            Image { source: root.char1_image_thumb; width: parent.width; height: parent.height; image-fit: cover; }
                                                            if ic1-ta.has-hover : Rectangle {
                                                                background: #000000b0;
                                                                Text { text: "✕"; font-size: 10px; font-weight: 700; color: M3.error; }
                                                            }
                                                            ic1-ta := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.remove_char_image_requested(0); } }
                                                        }
                                                        if (idx == 0 && !root.char1_image_loaded) : Rectangle {
                                                            width: 28px; height: 36px; border-radius: 4px;
                                                            background: M3.surface-container-low;
                                                            border-width: 1px; border-color: M3.outline-variant;
                                                            Text { text: "+"; font-size: 14px; font-weight: 700; color: M3.primary; }
                                                            TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.char_image_requested(0); } }
                                                        }
                                                        if (idx == 1 && root.char2_image_loaded) : Rectangle {
                                                            width: 28px; height: 36px; border-radius: 4px; clip: true;
                                                            Image { source: root.char2_image_thumb; width: parent.width; height: parent.height; image-fit: cover; }
                                                            if ic2-ta.has-hover : Rectangle {
                                                                background: #000000b0;
                                                                Text { text: "✕"; font-size: 10px; font-weight: 700; color: M3.error; }
                                                            }
                                                            ic2-ta := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.remove_char_image_requested(1); } }
                                                        }
                                                        if (idx == 1 && !root.char2_image_loaded) : Rectangle {
                                                            width: 28px; height: 36px; border-radius: 4px;
                                                            background: M3.surface-container-low;
                                                            border-width: 1px; border-color: M3.outline-variant;
                                                            Text { text: "+"; font-size: 14px; font-weight: 700; color: M3.info; }
                                                            TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.char_image_requested(1); } }
                                                        }
                                                        if (idx == 2 && root.char3_image_loaded) : Rectangle {
                                                            width: 28px; height: 36px; border-radius: 4px; clip: true;
                                                            Image { source: root.char3_image_thumb; width: parent.width; height: parent.height; image-fit: cover; }
                                                            if ic3-ta.has-hover : Rectangle {
                                                                background: #000000b0;
                                                                Text { text: "✕"; font-size: 10px; font-weight: 700; color: M3.error; }
                                                            }
                                                            ic3-ta := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.remove_char_image_requested(2); } }
                                                        }
                                                        if (idx == 2 && !root.char3_image_loaded) : Rectangle {
                                                            width: 28px; height: 36px; border-radius: 4px;
                                                            background: M3.surface-container-low;
                                                            border-width: 1px; border-color: M3.outline-variant;
                                                            Text { text: "+"; font-size: 14px; font-weight: 700; color: M3.success; }
                                                            TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.char_image_requested(2); } }
                                                        }
                                                        if (idx == 3 && root.char4_image_loaded) : Rectangle {
                                                            width: 28px; height: 36px; border-radius: 4px; clip: true;
                                                            Image { source: root.char4_image_thumb; width: parent.width; height: parent.height; image-fit: cover; }
                                                            if ic4-ta.has-hover : Rectangle {
                                                                background: #000000b0;
                                                                Text { text: "✕"; font-size: 10px; font-weight: 700; color: M3.error; }
                                                            }
                                                            ic4-ta := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.remove_char_image_requested(3); } }
                                                        }
                                                        if (idx == 3 && !root.char4_image_loaded) : Rectangle {
                                                            width: 28px; height: 36px; border-radius: 4px;
                                                            background: M3.surface-container-low;
                                                            border-width: 1px; border-color: M3.outline-variant;
                                                            Text { text: "+"; font-size: 14px; font-weight: 700; color: M3.tertiary; }
                                                            TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.char_image_requested(3); } }
                                                        }

                                                        Rectangle {
                                                            horizontal-stretch: 1;
                                                            min-height: 48px;
                                                            background: M3.surface-container-low;
                                                            border-radius: 6px;
                                                            border-width: 1px;
                                                            border-color: M3.outline-variant;

                                                            VerticalLayout {
                                                                padding: 4px;
                                                                TextEdit {
                                                                    text: c.actions;
                                                                    font-size: 11px;
                                                                    wrap: word-wrap;
                                                                    horizontal-stretch: 1;
                                                                    vertical-stretch: 1;
                                                                    edited => {
                                                                        root.scene_char_text_edited(idx, self.text);
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }

                                                    // Quick Reassign / Move buttons
                                                    HorizontalLayout {
                                                        spacing: 4px;
                                                        alignment: start;
                                                        if idx == 0 && root.app_tab >= 1 && c.has_actions : PillButton {
                                                            text: "→ Move to C2";
                                                            clicked => { root.scene_action_move_requested(0, 1); }
                                                        }
                                                        if idx == 1 && c.has_actions : PillButton {
                                                            text: "← Move to C1";
                                                            clicked => { root.scene_action_move_requested(1, 0); }
                                                        }
                                                        if idx == 1 && root.app_tab >= 2 && c.has_actions : PillButton {
                                                            text: "→ Move to C3";
                                                            clicked => { root.scene_action_move_requested(1, 2); }
                                                        }
                                                        if idx == 2 && c.has_actions : PillButton {
                                                            text: "← Move to C2";
                                                            clicked => { root.scene_action_move_requested(2, 1); }
                                                        }
                                                    }
                                                }
                                            }
                                        }

                                        // Advanced Settings Drawer (Prompt Overrides)
                                        if root.scene_adv_open : Rectangle {
                                            background: M3.surface-container;
                                            border-radius: 8px;
                                            border-width: 1px;
                                            border-color: M3.secondary-container;
                                            VerticalLayout {
                                                padding: 8px;
                                                spacing: 6px;
                                                Text {
                                                    text: "⚙ ADVANCED PROMPT OVERRIDES:";
                                                    font-size: 11px;
                                                    font-weight: 700;
                                                    color: M3.tertiary;
                                                }
                                                HorizontalLayout {
                                                    spacing: 8px;
                                                    SectionLabel { text: "Scene:"; vertical-alignment: center; }
                                                    LineEdit {
                                                        horizontal-stretch: 1;
                                                        font-size: 11px;
                                                        placeholder-text: "Custom scene setting override tags...";
                                                        text <=> root.scene_override_setting;
                                                        edited => { root.scene_overrides_changed(); }
                                                    }
                                                    SectionLabel { text: "Exclude:"; vertical-alignment: center; }
                                                    LineEdit {
                                                        horizontal-stretch: 1;
                                                        font-size: 11px;
                                                        placeholder-text: "Tags to strip (e.g. solo, watermark)...";
                                                        text <=> root.scene_override_exclude;
                                                        edited => { root.scene_overrides_changed(); }
                                                    }
                                                }
                                                HorizontalLayout {
                                                    spacing: 8px;
                                                    SectionLabel { text: "C1 Pose:"; vertical-alignment: center; }
                                                    LineEdit {
                                                        horizontal-stretch: 1;
                                                        font-size: 11px;
                                                        placeholder-text: "Char 1 pose override...";
                                                        text <=> root.scene_override_c1;
                                                        edited => { root.scene_overrides_changed(); }
                                                    }
                                                    if root.app_tab >= 1 : SectionLabel { text: "C2 Pose:"; vertical-alignment: center; }
                                                    if root.app_tab >= 1 : LineEdit {
                                                        horizontal-stretch: 1;
                                                        font-size: 11px;
                                                        placeholder-text: "Char 2 pose override...";
                                                        text <=> root.scene_override_c2;
                                                        edited => { root.scene_overrides_changed(); }
                                                    }
                                                    if root.app_tab >= 2 : SectionLabel { text: "C3 Pose:"; vertical-alignment: center; }
                                                    if root.app_tab >= 2 : LineEdit {
                                                        horizontal-stretch: 1;
                                                        font-size: 11px;
                                                        placeholder-text: "Char 3 pose override...";
                                                        text <=> root.scene_override_c3;
                                                        edited => { root.scene_overrides_changed(); }
                                                    }
                                                    if root.app_tab >= 3 : SectionLabel { text: "C4 Pose:"; vertical-alignment: center; }
                                                    if root.app_tab >= 3 : LineEdit {
                                                        horizontal-stretch: 1;
                                                        font-size: 11px;
                                                        placeholder-text: "Char 4 pose override...";
                                                        text <=> root.scene_override_c4;
                                                        edited => { root.scene_overrides_changed(); }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // ==================== ROW 3 & 4: WORKSPACE (LIVE SCENE STRIP + MULTI-CHARACTER GRIDS + AFTER/NEGATIVE) ====================
                    top := VerticalLayout {
                        vertical-stretch: 1;
                        spacing: 0px;
                        // nothing to show (no cards, no AI scene): a slim banner instead of the strip; it opens the
                        // strip (live scene card) on click, and the freed height goes to the prompt rows
                        if root.cards-empty : Rectangle {
                            height: 26px;
                            border-radius: 8px;
                            background: banner-ta.has-hover ? M3.surface-container-high : M3.surface-container;
                            banner-ta := TouchArea {
                                clicked => { root.cards_peek = !root.cards_peek; }
                            }
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 8px;
                                Text {
                                    text: root.raw_prompt == "" && root.app_tab == 0 ? "Paste a prompt to scan it" : "✓ Prompt clean, no conflicts";
                                    font-size: 11px;
                                    font-weight: 700;
                                    color: M3.success;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: root.live_headline;
                                    font-size: 11px;
                                    color: M3.on-surface-variant;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                }
                                if root.app_tab >= 1 : RegionPreview {
                                    width: 39px;
                                    height: 26px;
                                    regions: root.vrp_preview;
                                    aspect: root.vrp_preview_aspect;
                                    clicked => { root.edit_vrp_requested(); }
                                }
                                Text {
                                    text: root.cards_peek ? "Hide scene ▴" : "Show scene ▾";
                                    font-size: 11px;
                                    color: M3.primary;
                                    vertical-alignment: center;
                                }
                            }
                        }
                        if !root.cards-empty || root.cards_peek : HorizontalLayout {
                          preferred-height: root.cards_strip_height;
                          min-height: 72px;
                          vertical-stretch: 0;
                          spacing: 6px;
                          if root.app_tab >= 1 : VerticalLayout {
                            alignment: start;
                            spacing: 4px;
                            RegionPreview {
                                width: 120px;
                                height: 80px;
                                regions: root.vrp_preview;
                                aspect: root.vrp_preview_aspect;
                                clicked => { root.edit_vrp_requested(); }
                            }
                            Text {
                                text: "✎ regions";
                                font-size: 10px;
                                color: M3.on-surface-variant;
                                horizontal-alignment: center;
                            }
                          }
                          CardsPanel {
                            horizontal-stretch: 1;
                            cards: root.change_cards;
                            live-headline: root.live_headline;
                            live-details: root.live_details;
                            live-missing: root.live_missing;
                            scene-summary: root.scene_summary;
                            scene-details: root.scene_details;
                            scene-issues: root.scene_issues;
                            show-ai-button: root.ai_improved_available && (root.after_view == 0 || root.after_view == 3);
                            mode-changed(id, mode) => { root.card_mode_changed(id, mode); }
                            card-filter: root.card_filter;
                            filter-counts: root.card_filter_counts;
                            ideas-enabled: root.ollama_connected && root.raw_prompt != "";
                            ideas-busy: root.ideas_busy;
                            filter-changed(i) => { root.card_filter_changed(i); }
                            chip-toggled(id, tag) => { root.card_chip_toggled(id, tag); }
                            expand-fixes => { root.card_expand_fixes(); }
                            ideas => { root.ideas_requested(); }
                            show-ai => { if root.after_view == 3 { root.after_view_changed(4); } else { root.after_view_changed(1); } }
                          }
                        }
                        if !root.cards-empty || root.cards_peek : Splitter {
                            height: 10px;
                            dragged(d) => {
                                root.cards_strip_height = max(72px, min(root.cards_strip_height + d, top.height - 200px));
                            }
                        }
                        PromptColumn {
                            vertical-stretch: 1;
                            raw-prompt <=> root.raw_prompt;
                            lora-tags <=> root.lora_tags;
                            before-stats: root.before_stats;
                            after-stats: root.after_stats;
                            before-stats-warn: root.before_stats_warn;
                            after-stats-warn: root.after_stats_warn;
                            char2-stats-warn: root.char2_stats_warn;
                            char3-stats-warn: root.char3_stats_warn;
                            char4-stats-warn: root.char4_stats_warn;
                            condensed-plain: root.condensed_prompt;
                            after-view: root.after_view;
                            ai-improved-available: root.ai_improved_available;
                            dynamic-enabled: root.dynamic_enabled;
                            dynamic-note: root.dynamic_note;
                            rolled: root.after_rolled;
                            ai-dropped: root.ai_dropped;
                            substituted-list: root.substituted_list;
                            added-list: root.added_list;
                            category-breakdown: root.category_breakdown;
                            structure-rows: root.structure_rows;
                            char-count: root.app_tab + 1;
                            char2-prompt <=> root.char2_prompt;
                            char3-prompt <=> root.char3_prompt;
                            char4-prompt <=> root.char4_prompt;
                            char2-lora-tags <=> root.char2_lora_tags;
                            char3-lora-tags <=> root.char3_lora_tags;
                            char4-lora-tags <=> root.char4_lora_tags;
                            lora-suggest-c1: root.lora_suggest_c1;
                            lora-suggest-c2: root.lora_suggest_c2;
                            lora-suggest-c3: root.lora_suggest_c3;
                            lora-suggest-c4: root.lora_suggest_c4;
                            lora-weights-c1: root.lora_weights_c1;
                            lora-weights-c2: root.lora_weights_c2;
                            lora-weights-c3: root.lora_weights_c3;
                            lora-weights-c4: root.lora_weights_c4;
                            lora-step(c, i, d) => { root.lora_weight_step(c, i, d); }
                            char2-stats: root.char2_stats;
                            char3-stats: root.char3_stats;
                            char4-stats: root.char4_stats;
                            before-ratio <=> root.before_ratio;
                            side-width <=> root.side_width;
                            negative-plain: root.negative_text;
                            negative-note: root.negative_note;
                            negative-available: root.negative_text != "";
                            negative-expanded <=> root.negative_expanded;
                            quality-available: root.checkpoint_index != 5;
                            add-quality => { root.add_quality_requested(); }
                            negative-tokens: root.negative_tokens;
                            zen: root.zen_mode;
                            edited => { root.analyze_requested(); }
                            after-view-changed(v) => { root.after_view_changed(v); }
                            roll => { root.roll_requested(); }
                            copy => { root.copy_output_requested(); root.show-copied(); }
                            copy-section-blocks => { root.copy_section_blocks_requested(); root.show-copied(); }
                            copy-negative => { root.copy_recommended_negative_requested(); root.show-copied(); }
                            output-collapsed <=> root.output_collapsed;
                            export-index <=> root.export_index;
                        }
                    }
                }
            }
        }

        // ==================== ROW 5: STATUS BAR ====================
        Rectangle {
            background: M3.surface-container;
            border-radius: 10px;
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                padding-top: 5px;
                padding-bottom: 5px;
                spacing: 14px;
                Text {
                    text: root.status_message;
                    font-size: 11px;
                    color: M3.on-surface;
                    overflow: elide;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }
                PillButton {
                    text: "⚡ Queue";
                    enabled: root.comfyui_online;
                    clicked => { root.queue_comfyui_requested(); }
                }
                // one pill: checkpoint · version · token estimate · verdict · last run · hardware
                Rectangle {
                    border-radius: 10px;
                    background: M3.surface-container-high;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        padding-top: 2px;
                        padding-bottom: 2px;
                        spacing: 6px;
                        Text {
                            text: root.checkpoint-names[root.checkpoint_index] + (root.app_version != "" ? " · v" + root.app_version : "")
                                + (root.after_stats != "" ? " · " + root.after_stats : "") + " ·";
                            font-size: 11px;
                            color: M3.on-surface;
                            vertical-alignment: center;
                        }
                        Text {
                            text: root.issue_summary;
                            font-size: 11px;
                            font-weight: 700;
                            color: root.issue_summary == "✓ Clean" ? M3.success : M3.warning;
                            vertical-alignment: center;
                        }
                        if root.run_badge != "" : Text {
                            text: "· " + root.run_badge;
                            font-size: 11px;
                            font-weight: 700;
                            color: M3.success;
                            vertical-alignment: center;
                        }
                        Text {
                            text: root.comfyui_online ? "· ComfyUI ●" : "· ComfyUI ○";
                            font-size: 11px;
                            font-weight: 700;
                            color: root.comfyui_online ? M3.success : M3.on-surface-variant;
                            vertical-alignment: center;
                        }
                        if root.hardware_badge != "" : Text {
                            text: "· " + root.hardware_badge;
                            font-size: 11px;
                            font-weight: 700;
                            color: M3.primary;
                            vertical-alignment: center;
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 5px;
                    Text { text: "UI size"; font-size: 11px; color: M3.on-surface-variant; vertical-alignment: center; }
                    Rectangle {
                        width: 20px;
                        height: 20px;
                        border-radius: 10px;
                        background: zo-ta.has-hover ? M3.secondary-container : M3.surface-container-high;
                        Text { text: "−"; font-size: 13px; color: M3.on-surface; }
                        zo-ta := TouchArea { clicked => { root.zoom_out_requested(); } }
                    }
                    Text {
                        text: root.ui_zoom_percent + "%";
                        font-size: 11px;
                        color: M3.on-surface;
                        vertical-alignment: center;
                        min-width: 32px;
                        horizontal-alignment: center;
                    }
                    Rectangle {
                        width: 20px;
                        height: 20px;
                        border-radius: 10px;
                        background: zi-ta.has-hover ? M3.secondary-container : M3.surface-container-high;
                        Text { text: "+"; font-size: 13px; color: M3.on-surface; }
                        zi-ta := TouchArea { clicked => { root.zoom_in_requested(); } }
                    }
                }
            }
        }
    }

    // ==================== DANBOORU TRANSLATOR DIALOG ====================
    if root.vrp_open : Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        background: #000000b0;
        TouchArea { }
        Rectangle {
            width: min(parent.width - 32px, 980px);
            height: min(parent.height - 32px, 760px);
            border-radius: 16px;
            background: M3.surface-container;
            clip: true;
            VerticalLayout {
                padding: 18px;
                spacing: 8px;
                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: "VRP regions";
                        font-size: 18px;
                        font-weight: 700;
                        color: M3.on-surface;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    PillButton {
                        text: "↺ Reset";
                        clicked => { root.vrp_reset_requested(); }
                    }
                    PillButton {
                        text: "🗺 Copy VRP regions";
                        primary: true;
                        clicked => { root.copy_vrp_requested(); root.show-copied(); }
                    }
                    PillButton {
                        text: "✕ Close";
                        clicked => { root.vrp_open = false; }
                    }
                }
                Text {
                    text: "Drag a box to move it, drag its corner to resize it. Copy writes these boxes into the Anima VRP (core) node's vrp_state; the Scene box goes into the node's global prompt.";
                    font-size: 12px;
                    color: M3.on-surface-variant;
                    wrap: word-wrap;
                }
                // the canvas keeps the picture's shape, as large as fits
                vrp-area := Rectangle {
                    vertical-stretch: 1;
                    vrp-canvas := Rectangle {
                        width: min(parent.width, parent.height * root.vrp_aspect);
                        height: self.width / root.vrp_aspect;
                        background: M3.surface-container-high;
                        clip: true;
                        if root.vrp_has_image : Image {
                            width: parent.width;
                            height: parent.height;
                            source: root.image_thumb;
                            image-fit: fill;
                            opacity: 0.85;
                        }
                        for r[i] in root.vrp_regions : Rectangle {
                            x: r.x * vrp-canvas.width;
                            y: r.y * vrp-canvas.height;
                            width: r.w * vrp-canvas.width;
                            height: r.h * vrp-canvas.height;
                            border-width: 2px;
                            border-color: i == 0 ? #eb1e1e : i == 1 ? #1e6ef5 : i == 2 ? #28be3c : #f5c814;
                            background: i == 0 ? #eb1e1e30 : i == 1 ? #1e6ef530 : i == 2 ? #28be3c30 : #f5c81430;
                            move-ta := TouchArea {
                                mouse-cursor: move;
                                moved => {
                                    root.vrp_region_moved(i, (self.mouse-x - self.pressed-x) / vrp-canvas.width, (self.mouse-y - self.pressed-y) / vrp-canvas.height);
                                }
                            }
                            Text {
                                x: 6px;
                                y: 4px;
                                text: "Character " + (i + 1);
                                font-size: 13px;
                                font-weight: 700;
                                color: white;
                            }
                            // resize handle, bottom-right corner
                            Rectangle {
                                x: parent.width - 16px;
                                y: parent.height - 16px;
                                width: 16px;
                                height: 16px;
                                background: i == 0 ? #eb1e1e : i == 1 ? #1e6ef5 : i == 2 ? #28be3c : #f5c814;
                                TouchArea {
                                    mouse-cursor: nwse-resize;
                                    moved => {
                                        root.vrp_region_resized(i, (self.mouse-x - self.pressed-x) / vrp-canvas.width, (self.mouse-y - self.pressed-y) / vrp-canvas.height);
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // ==================== 🎨 PALETTE ====================
    if root.palette_open : Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        background: #00000080;
        TouchArea { clicked => { root.palette_open = false; } }
        Rectangle {
            width: min(parent.width - 32px, 640px);
            height: min(parent.height - 32px, palette-layout.preferred-height);
            border-radius: 16px;
            background: M3.surface-container;
            clip: true;
            TouchArea { }
            palette-layout := VerticalLayout {
                padding: 16px;
                spacing: 6px;
                alignment: start;
                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: "🎨 Palette";
                        font-size: 16px;
                        font-weight: 700;
                        color: M3.on-surface;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    PillButton {
                        text: "✕ Close";
                        clicked => { root.palette_open = false; }
                    }
                }
                Text {
                    text: root.app_tab >= 1 ? "A click adds the tag to the Scene box (shared by every character)." : "A click adds the tag to the end of Before. Tags already there are skipped.";
                    font-size: 12px;
                    color: M3.on-surface-variant;
                    wrap: word-wrap;
                }
                for row in root.palette_rows : HorizontalLayout {
                    spacing: 4px;
                    alignment: start;
                    Text {
                        width: 78px;
                        text: row.title;
                        font-size: 11px;
                        font-weight: 700;
                        color: M3.primary;
                        vertical-alignment: center;
                    }
                    for tag in row.tags : Rectangle {
                        height: 24px;
                        min-width: pal-label.preferred-width + 16px;
                        border-radius: 12px;
                        border-width: 1px;
                        border-color: M3.outline-variant;
                        background: pal-ta.has-hover ? M3.secondary-container : M3.surface-container-high;
                        accessible-role: button;
                        accessible-label: "+ " + tag;
                        pal-label := Text { text: "+ " + tag; font-size: 11px; color: M3.on-surface; }
                        pal-ta := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => { root.palette_tag_clicked(tag); }
                        }
                    }
                }
            }
        }
    }

    // ==================== PROMPT HISTORY ====================
    if root.history_open : Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        background: #000000b0;
        TouchArea { clicked => { root.history_open = false; } }
        Rectangle {
            width: min(parent.width - 32px, 620px);
            height: min(parent.height - 32px, 560px);
            border-radius: 16px;
            background: M3.surface-container;
            clip: true;
            TouchArea { }
            VerticalLayout {
                padding: 18px;
                spacing: 8px;
                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: "Prompt history";
                        font-size: 18px;
                        font-weight: 700;
                        color: M3.on-surface;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                    PillButton {
                        text: "⭐ Stash";
                        primary: true;
                        clicked => { root.history_stash_requested(); }
                    }
                    PillButton {
                        text: "✕ Close";
                        clicked => { root.history_open = false; }
                    }
                }
                Text {
                    text: "Saved after a 2.5 s typing pause: the 15 latest plus up to 10 starred (kept for good). Restore puts your current text at the top first, so it can be undone.";
                    font-size: 12px;
                    color: M3.on-surface-variant;
                    wrap: word-wrap;
                }
                if root.history_rows.length == 0 : Text {
                    text: "Nothing yet: type a prompt, or press ⭐ Stash.";
                    font-size: 13px;
                    color: M3.on-surface-variant;
                }
                hist-scroll := ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        width: hist-scroll.visible-width;
                        spacing: 4px;
                        alignment: start;
                        for row[i] in root.history_rows : Rectangle {
                            height: 36px;
                            border-radius: 8px;
                            background: M3.surface-container-high;
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 8px;
                                alignment: stretch;
                                PillButton {
                                    text: row.starred ? "★" : "☆";
                                    primary: row.starred;
                                    clicked => { root.history_star_toggled(i); }
                                }
                                Text {
                                    text: row.when;
                                    font-size: 11px;
                                    color: M3.on-surface-variant;
                                    vertical-alignment: center;
                                    min-width: 64px;
                                }
                                Text {
                                    text: row.label + (row.chars > 1 ? "  · " + row.chars + " characters" : "");
                                    font-size: 12px;
                                    color: M3.on-surface;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                }
                                PillButton {
                                    text: "Restore";
                                    clicked => { root.history_restore_requested(i); }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    if root.translate_open : Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        background: #000000b0;
        TouchArea { }
        Rectangle {
            width: min(parent.width - 32px, 760px);
            height: min(parent.height - 32px, 640px);
            border-radius: 16px;
            background: M3.surface-container;
            clip: true;
            VerticalLayout {
                padding: 18px;
                spacing: 8px;
                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: "Danbooru Words";
                        font-size: 18px;
                        font-weight: 700;
                        color: M3.on-surface;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    PillButton {
                        text: "✕ Close";
                        clicked => { root.translate_open = false; }
                    }
                }
                Text {
                    text: "Describe something the model may not understand (unusual words, metaphors, prose). The AI rewrites it as real Danbooru tags, picked from and checked against Danbooru's tag list.";
                    font-size: 12px;
                    color: M3.on-surface-variant;
                    wrap: word-wrap;
                }
                TextEdit {
                    height: 84px;
                    font-size: 13px;
                    wrap: word-wrap;
                    text <=> root.translate_input;
                }
                HorizontalLayout {
                    spacing: 10px;
                    alignment: start;
                    PillButton {
                        primary: true;
                        text: root.translate_busy ? "Working…" : "Find Danbooru Tags";
                        enabled: !root.translate_busy;
                        clicked => { root.translate_requested(); }
                    }
                    Text {
                        text: root.translate_status;
                        font-size: 12px;
                        color: M3.on-surface-variant;
                        vertical-alignment: center;
                        wrap: word-wrap;
                    }
                }
                SectionLabel { text: "DANBOORU TAGS (EDITABLE)"; color: M3.primary; }
                TextEdit {
                    vertical-stretch: 1;
                    min-height: 60px;
                    font-size: 13px;
                    wrap: word-wrap;
                    text <=> root.translate_tags;
                }
                SectionLabel { text: "WHAT CHANGED"; }
                TextEdit {
                    vertical-stretch: 1;
                    min-height: 60px;
                    font-size: 12px;
                    wrap: word-wrap;
                    read-only: true;
                    text: root.translate_notes;
                }
                if root.translate_nl : CheckBox {
                    text: "Also add the natural-language scene description";
                    checked <=> root.translate_use_natural;
                }
                if root.translate_nl && root.translate_use_natural : TextEdit {
                    height: 64px;
                    font-size: 12px;
                    wrap: word-wrap;
                    text <=> root.translate_natural;
                }
                if !root.translate_nl : Text {
                    text: "A natural-language description is available for Anima, SDXL and Flux.";
                    font-size: 11px;
                    color: M3.on-surface-variant;
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    PillButton {
                        text: "Replace Before";
                        enabled: root.translate_tags != "" && !root.translate_busy;
                        clicked => { root.translate_apply_requested(true); }
                    }
                    PillButton {
                        primary: true;
                        text: "Add to Before";
                        enabled: root.translate_tags != "" && !root.translate_busy;
                        clicked => { root.translate_apply_requested(false); }
                    }
                }
            }
        }
    }

    toast-timer := Timer {
        interval: 1200ms;
        running: false;
        triggered => {
            root.toast-on = false;
            self.running = false;
        }
    }

    // "✓ Copied" toast: on top of everything, lets clicks through (no TouchArea)
    Rectangle {
        x: (root.width - self.width) / 2;
        y: root.height - self.height - 56px;
        width: toast-label.preferred-width + 32px;
        height: 32px;
        border-radius: 16px;
        background: M3.primary;
        opacity: root.toast-on ? 0.95 : 0;
        animate opacity { duration: 250ms; }
        toast-label := Text {
            text: "✓ Copied";
            font-size: 13px;
            font-weight: 700;
            color: M3.on-primary;
        }
    }
}
